<UserControl x:Class="JingXu.Workbench.Features.Queue.RenderQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:queue="clr-namespace:JingXu.Workbench.Features.Queue"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance queue:RenderQueueViewModel}"
             Background="Transparent">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 矩形分段筛选器 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding Title}"
                       Style="{DynamicResource Text.Title}"
                       VerticalAlignment="Center" />
            <Border Grid.Column="1" Style="{DynamicResource Segmented.Container}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{DynamicResource Segmented.Item}"
                                 GroupName="queueScope"
                                 Content="全部"
                                 IsChecked="{Binding Scope, Converter={StaticResource EnumToBool}, ConverterParameter=All}" />
                    <RadioButton Style="{DynamicResource Segmented.Item}"
                                 GroupName="queueScope"
                                 Content="进行中"
                                 IsChecked="{Binding Scope, Converter={StaticResource EnumToBool}, ConverterParameter=Active}" />
                    <RadioButton Style="{DynamicResource Segmented.Item}"
                                 GroupName="queueScope"
                                 Content="已结束"
                                 IsChecked="{Binding Scope, Converter={StaticResource EnumToBool}, ConverterParameter=Finished}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 概览计数 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10">
            <TextBlock Style="{DynamicResource Text.Caption}">
                <Run Text="共" /><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" 个" />
                <Run Text="· 进行中 " /><Run Text="{Binding ActiveCount, Mode=OneWay}" />
                <Run Text="· 已结束 " /><Run Text="{Binding FinishedCount, Mode=OneWay}" />
                <Run Text="· 失败 " /><Run Text="{Binding FailedCount, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <!-- 空状态 -->
        <Border Grid.Row="2"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource Surface.PanelMuted}"
                BorderBrush="{DynamicResource Line.Default}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Standard}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                <Path Data="{DynamicResource Icon.Module.Queue}"
                      Stroke="{DynamicResource Line.Strong}"
                      StrokeThickness="1.5"
                      Width="34"
                      Height="34"
                      Stretch="Uniform"
                      HorizontalAlignment="Center" />
                <TextBlock Text="队列为空"
                           Style="{DynamicResource Text.Body}"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,4"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding EmptyHint}"
                           Style="{DynamicResource Text.Caption}"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 任务列表（协调器接入后自动填充）-->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVis}}">
            <ItemsControl ItemsSource="{Binding VisibleJobs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type queue:RenderJobRowViewModel}">
                        <Border BorderBrush="{DynamicResource Line.Default}"
                                BorderThickness="0,0,0,1"
                                Padding="4,10"
                                AutomationProperties.Name="{Binding Status.AutomationName}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Data="{Binding Status.IconKey, Converter={StaticResource ResourceLookup}}"
                                      Stroke="{Binding Status.FillKey, Converter={StaticResource ResourceLookup}}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Style="{DynamicResource Text.Body}" />
                                    <TextBlock Text="{Binding ShortId}" Style="{DynamicResource Text.Mono}" Foreground="{DynamicResource Ink.Muted}" FontSize="10.5" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           VerticalAlignment="Center"
                                           Text="{Binding Status.Text}"
                                           FontFamily="{DynamicResource Font.Body}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Status.TextKey, Converter={StaticResource ResourceLookup}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
