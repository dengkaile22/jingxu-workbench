<UserControl x:Class="JingXu.Workbench.Features.Composition.CompositionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:composition="clr-namespace:JingXu.Workbench.Features.Composition"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance composition:CompositionViewModel}"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource Text.Title}" />
                    <TextBlock Text="{Binding PreviewSummary}"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{DynamicResource Button.Secondary}"
                        Content="导入素材"
                        Command="{Binding PickImportFilesCommand}"
                        IsEnabled="{Binding CanPickImportFiles}"
                        AutomationProperties.Name="导入视频素材" />
            </Grid>

            <TextBlock Text="{Binding StatusMessage}"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,8,0,0"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}" />

            <TextBlock Text="素材" Style="{DynamicResource Text.SectionHeader}" Margin="0,18,0,8" />
            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="12,8"
                    Visibility="{Binding HasMaterials, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Materials}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type composition:MaterialRowViewModel}">
                            <Border BorderBrush="{DynamicResource Line.Default}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,8"
                                    Cursor="Hand"
                                    Background="Transparent">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.SelectMaterialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Surface.Sunk}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SequenceLabel}"
                                               Style="{DynamicResource Text.Mono}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                        <TextBlock Text="{Binding FileName}" Style="{DynamicResource Text.Body}" />
                                        <TextBlock Text="{Binding Diagnostic}"
                                                   Style="{DynamicResource Text.Caption}"
                                                   Foreground="{DynamicResource Status.Running.Text}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasDiagnostic, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DurationText}"
                                               Style="{DynamicResource Text.Mono}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding ResolutionText}"
                                               Style="{DynamicResource Text.Caption}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="16,20"
                    Visibility="{Binding HasMaterials, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="暂无素材。点击「导入素材」选择视频文件，系统将自动探测时长、分辨率并解析文件名序号。"
                           Style="{DynamicResource Text.Caption}"
                           TextAlignment="Center" />
            </Border>

            <TextBlock Text="编排" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <Border Style="{DynamicResource Segmented.Container}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{DynamicResource Segmented.Item}"
                                 GroupName="compositionMode"
                                 Content="随机批量"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Random}" />
                    <RadioButton Style="{DynamicResource Segmented.Item}"
                                 GroupName="compositionMode"
                                 Content="自定义序号"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=CustomSequence}" />
                </StackPanel>
            </Border>

            <Grid Margin="0,12,0,0"
                  Visibility="{Binding IsRandomMode, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="批量数量" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding BatchCount, UpdateSourceTrigger=PropertyChanged}"
                         Margin="10,0,0,0"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="随机批量数量" />
                <TextBlock Grid.Column="3" Text="随机种子" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                <TextBox Grid.Column="4"
                         Text="{Binding RandomSeed, UpdateSourceTrigger=PropertyChanged}"
                         Margin="10,0,0,0"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="随机种子" />
            </Grid>

            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding IsCustomMode, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="序号表达式（一条成片的片段顺序）" Style="{DynamicResource Text.Caption}" />
                <TextBox Text="{Binding SequenceExpression, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,6,0,0"
                         Padding="10,8"
                         MinHeight="72"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="自定义序号表达式" />
                <TextBlock Style="{DynamicResource Text.Caption}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap">
                    <Run Text="单任务：" />
                    <Run Text="264513" FontFamily="{DynamicResource Font.Mono}" />
                    <Run Text=" 或 " />
                    <Run Text="2,6,14,5,1,3" FontFamily="{DynamicResource Font.Mono}" />
                    <LineBreak />
                    <Run Text="多任务：每行一串，或用分号分隔，如 " />
                    <Run Text="264513; 351246" FontFamily="{DynamicResource Font.Mono}" />
                    <Run Text="。每条表达式生成一条独立入队任务。" />
                </TextBlock>
            </StackPanel>

            <TextBlock Text="编排预览" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <ItemsControl ItemsSource="{Binding PreviewPlans}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type composition:PreviewPlanRowViewModel}">
                        <Border Background="{DynamicResource Surface.PanelMuted}"
                                BorderBrush="{DynamicResource Line.Default}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Standard}"
                                Padding="14,12"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding DurationText}" Style="{DynamicResource Text.Mono}" />
                                </Grid>
                                <TextBlock Text="{Binding SequenceText}"
                                           Style="{DynamicResource Text.Mono}"
                                           FontSize="11.5"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding ValidationMessage}"
                       Style="{DynamicResource Text.Caption}"
                       Foreground="{DynamicResource Status.Running.Text}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVis}}" />

            <TextBlock Text="输出" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="输出目录" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                         Margin="10,0,8,0"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="成片输出目录" />
                <Button Grid.Column="2"
                        Style="{DynamicResource Button.Secondary}"
                        Content="浏览…"
                        Command="{Binding PickOutputDirectoryCommand}"
                        AutomationProperties.Name="选择成片输出目录" />
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="文件名前缀" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding OutputFileNamePrefix, UpdateSourceTrigger=PropertyChanged}"
                         Margin="10,0,0,0"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="成片文件名前缀" />
            </Grid>
            <TextBlock Text="单条成片使用「前缀.mp4」；批量时自动追加 _001、_002 等序号。"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,6,0,0" />

            <TextBlock Text="统一比例" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="14,12">
                <StackPanel>
                    <CheckBox Content="启用统一比例（片段与蒙版对齐到同一画幅后再叠加）"
                              IsChecked="{Binding EnableUnifiedAspect}"
                              AutomationProperties.Name="启用统一比例" />
                    <TextBlock Text="目标画幅"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,10,0,6"
                               IsEnabled="{Binding EnableUnifiedAspect}" />
                    <Border Style="{DynamicResource Segmented.Container}"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding EnableUnifiedAspect}">
                        <WrapPanel>
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="aspectPreset"
                                         Content="9:16 竖屏"
                                         IsChecked="{Binding AspectPreset, Converter={StaticResource EnumToBool}, ConverterParameter=Vertical9x16}" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="aspectPreset"
                                         Content="16:9 横屏"
                                         IsChecked="{Binding AspectPreset, Converter={StaticResource EnumToBool}, ConverterParameter=Horizontal16x9}" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="aspectPreset"
                                         Content="1:1 方形"
                                         IsChecked="{Binding AspectPreset, Converter={StaticResource EnumToBool}, ConverterParameter=Square1x1}" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="aspectPreset"
                                         Content="继承首段"
                                         IsChecked="{Binding AspectPreset, Converter={StaticResource EnumToBool}, ConverterParameter=InheritFirst}" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="aspectPreset"
                                         Content="自定义"
                                         IsChecked="{Binding AspectPreset, Converter={StaticResource EnumToBool}, ConverterParameter=Custom}" />
                        </WrapPanel>
                    </Border>
                    <Grid Margin="0,10,0,0"
                          Visibility="{Binding IsCustomAspectPreset, Converter={StaticResource BoolToVis}}"
                          IsEnabled="{Binding EnableUnifiedAspect}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="自定义" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding CustomAspectWidth, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="×" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <TextBox Grid.Column="3"
                                 Text="{Binding CustomAspectHeight, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 VerticalContentAlignment="Center" />
                    </Grid>
                    <TextBlock Text="拼接素材适配"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,12,0,6"
                               IsEnabled="{Binding EnableUnifiedAspect}" />
                    <Border Style="{DynamicResource Segmented.Container}"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding EnableUnifiedAspect}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="clipFitMode"
                                         Content="居中裁切"
                                         IsChecked="{Binding ClipFitMode, Converter={StaticResource EnumToBool}, ConverterParameter=CenterCrop}" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="clipFitMode"
                                         Content="黑边"
                                         IsChecked="{Binding ClipFitMode, Converter={StaticResource EnumToBool}, ConverterParameter=Letterbox}" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="clipFitMode"
                                         Content="拉伸"
                                         IsChecked="{Binding ClipFitMode, Converter={StaticResource EnumToBool}, ConverterParameter=Stretch}" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="clipFitMode"
                                         Content="模糊背景"
                                         IsChecked="{Binding ClipFitMode, Converter={StaticResource EnumToBool}, ConverterParameter=BlurBackground}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="蒙版素材适配"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,12,0,6"
                               IsEnabled="{Binding EnableUnifiedAspect}" />
                    <Border Style="{DynamicResource Segmented.Container}"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding EnableUnifiedAspect}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="overlayFitMode"
                                         Content="填满裁切"
                                         IsChecked="{Binding OverlayFitMode, Converter={StaticResource EnumToBool}, ConverterParameter=FillCrop}" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="overlayFitMode"
                                         Content="完整适配"
                                         IsChecked="{Binding OverlayFitMode, Converter={StaticResource EnumToBool}, ConverterParameter=Contain}" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="overlayFitMode"
                                         Content="拉伸"
                                         IsChecked="{Binding OverlayFitMode, Converter={StaticResource EnumToBool}, ConverterParameter=Stretch}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding UnifiedAspectPreviewDescription}"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="蒙版叠加" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="14,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  Content="启用蒙版叠加到成片"
                                  IsChecked="{Binding EnableOverlayOnOutput}"
                                  AutomationProperties.Name="启用蒙版叠加到成片" />
                        <Border Grid.Column="1"
                                Background="{DynamicResource Surface.Sunk}"
                                BorderBrush="{DynamicResource Line.Default}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Small}"
                                Padding="8,4"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding OverlayStatusLabel}"
                                       Style="{DynamicResource Text.Caption}"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <CheckBox Content="随机套用素材库蒙版（按任务种子确定性选取）"
                              IsChecked="{Binding UseRandomOverlayLibrary}"
                              IsEnabled="{Binding IsOverlaySectionEnabled}"
                              Margin="0,10,0,0"
                              AutomationProperties.Name="随机套用素材库蒙版" />
                    <TextBlock Text="蒙版在渲染阶段叠加到最终成片；关闭开关时入队不带蒙版层。参数在「蒙版」页配置，素材可手动指定或从素材库随机。"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="效果与音频" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <CheckBox Content="启用标准差异化滤镜（镜像 / 轻裁切 / 调色 / 降噪）"
                      IsChecked="{Binding EnableVariationEffects}"
                      Margin="0,0,0,10"
                      AutomationProperties.Name="启用标准差异化滤镜" />

            <CheckBox Content="混入背景音乐"
                      IsChecked="{Binding EnableBgm}"
                      AutomationProperties.Name="启用背景音乐混音" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="BGM 文件" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding BgmPath, UpdateSourceTrigger=PropertyChanged}"
                         Margin="10,0,8,0"
                         Padding="8,6"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="背景音乐文件路径" />
                <Button Grid.Column="2"
                        Style="{DynamicResource Button.Secondary}"
                        Content="选择…"
                        Command="{Binding PickBgmFileCommand}"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="选择背景音乐文件" />
                <Button Grid.Column="3"
                        Style="{DynamicResource Button.Secondary}"
                        Content="清除"
                        Command="{Binding ClearBgmCommand}"
                        AutomationProperties.Name="清除背景音乐" />
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="原声音量 %" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding OriginalVolumePercent, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="原声音量百分比" />
                <TextBlock Grid.Column="3" Text="BGM 音量 %" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                <TextBox Grid.Column="4"
                         Text="{Binding BgmVolumePercent, UpdateSourceTrigger=PropertyChanged}"
                         Margin="10,0,0,0"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="背景音乐音量百分比" />
            </Grid>
            <TextBlock Text="未选择 BGM 时保留原声；选择后 BGM 默认 18% 并循环至成片结束，尾部淡出 1 秒。"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />

            <Button Style="{DynamicResource Button.Primary}"
                    Content="加入队列"
                    HorizontalAlignment="Left"
                    Margin="0,16,0,0"
                    Command="{Binding EnqueueCommand}"
                    AutomationProperties.Name="将编排结果加入渲染队列" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
