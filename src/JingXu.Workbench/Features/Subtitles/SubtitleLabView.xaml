<UserControl x:Class="JingXu.Workbench.Features.Subtitles.SubtitleLabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:subtitles="clr-namespace:JingXu.Workbench.Features.Subtitles"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance subtitles:SubtitleLabViewModel}"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource Text.Title}" />
                    <TextBlock Text="离线字幕导入、编辑、OCR 检测、Whisper 识别与 FFmpeg 烧录。"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{DynamicResource Button.Secondary}"
                            Content="导入视频"
                            Command="{Binding PickVideoCommand}"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="导入视频" />
                    <Button Style="{DynamicResource Button.Secondary}"
                            Content="导入字幕"
                            Command="{Binding ImportSubtitleCommand}"
                            AutomationProperties.Name="导入字幕" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding StatusMessage}"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,8,0,0"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}" />

            <TextBlock Text="{Binding VideoPath, StringFormat=当前视频：{0}}"
                       Style="{DynamicResource Text.Body}"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasVideo, Converter={StaticResource BoolToVis}}" />

            <TextBlock Text="预览与区域选择" Style="{DynamicResource Text.SectionHeader}" Margin="0,18,0,8" />
            <TextBlock Text="{Binding PreviewHint}"
                       Style="{DynamicResource Text.Caption}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
            <Border x:Name="PreviewHost"
                    Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Height="220"
                    ClipToBounds="True"
                    MouseLeftButtonDown="PreviewHost_OnMouseLeftButtonDown"
                    MouseMove="PreviewHost_OnMouseMove"
                    MouseLeftButtonUp="PreviewHost_OnMouseLeftButtonUp">
                <Grid>
                    <TextBlock Text="导入视频后可在此框选字幕区域"
                               Style="{DynamicResource Text.Caption}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasVideo, Converter={StaticResource InverseBoolToVis}}" />
                    <Canvas IsHitTestVisible="False">
                        <Rectangle Canvas.Left="{Binding SelectionOverlayRect.X}"
                                   Canvas.Top="{Binding SelectionOverlayRect.Y}"
                                   Width="{Binding SelectionOverlayRect.Width}"
                                   Height="{Binding SelectionOverlayRect.Height}"
                                   Stroke="{DynamicResource Status.Running.Text}"
                                   StrokeThickness="2"
                                   Fill="#33C4A35A"
                                   Visibility="{Binding HasSelectionOverlay, Converter={StaticResource BoolToVis}}" />
                    </Canvas>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <CheckBox Content="全画面 OCR 扫描"
                          IsChecked="{Binding ScanFullFrame}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0" />
                <TextBlock Text="{Binding ScanRegionDescription}"
                           Style="{DynamicResource Text.Caption}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <Button Style="{DynamicResource Button.Secondary}"
                        Content="确认手动区域"
                        Command="{Binding ApplyManualRegionAsDetectedCommand}"
                        AutomationProperties.Name="确认手动框选的字幕区域" />
            </StackPanel>

            <TextBlock Text="检测与识别" Style="{DynamicResource Text.SectionHeader}" Margin="0,18,0,8" />
            <StackPanel Orientation="Horizontal">
                <Button Style="{DynamicResource Button.Secondary}"
                        Content="OCR 检测硬字幕"
                        Command="{Binding DetectRegionsCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="OCR 检测硬字幕" />
                <Button Style="{DynamicResource Button.Secondary}"
                        Content="Whisper 语音识别"
                        Command="{Binding TranscribeCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="Whisper 语音识别" />
                <Button Style="{DynamicResource Button.Secondary}"
                        Content="确认全部区域"
                        Command="{Binding ConfirmAllSegmentsCommand}"
                        AutomationProperties.Name="确认全部检测区域" />
            </StackPanel>

            <TextBlock Text="去字幕方式" Style="{DynamicResource Text.SectionHeader}" Margin="0,18,0,8" />
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="区域模糊"
                             GroupName="RemovalMode"
                             IsChecked="{Binding RemovalMode, Converter={StaticResource EnumToBool}, ConverterParameter=Blur}"
                             Margin="0,0,16,0" />
                <RadioButton Content="Delogo 修补"
                             GroupName="RemovalMode"
                             IsChecked="{Binding RemovalMode, Converter={StaticResource EnumToBool}, ConverterParameter=Delogo}"
                             Margin="0,0,16,0" />
                <RadioButton Content="裁切重构"
                             GroupName="RemovalMode"
                             IsChecked="{Binding RemovalMode, Converter={StaticResource EnumToBool}, ConverterParameter=CropAndReframe}" />
            </StackPanel>

            <TextBlock Text="字幕列表" Style="{DynamicResource Text.SectionHeader}" Margin="0,18,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Style="{DynamicResource Button.Secondary}"
                        Content="新增条目"
                        Command="{Binding AddCueCommand}"
                        Margin="0,0,8,0" />
                <Button Style="{DynamicResource Button.Secondary}"
                        Content="导出 SRT"
                        Command="{Binding ExportSrtCommand}" />
            </StackPanel>

            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="8">
                <ItemsControl ItemsSource="{Binding Cues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type subtitles:SubtitleCueRowViewModel}">
                            <Border BorderBrush="{DynamicResource Line.Default}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Index}"
                                               Style="{DynamicResource Text.Mono}"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,8,0"
                                             AutomationProperties.Name="开始时间" />
                                    <TextBox Grid.Column="2"
                                             Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,8,0"
                                             AutomationProperties.Name="结束时间" />
                                    <TextBox Grid.Column="3"
                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,8,0"
                                             AutomationProperties.Name="字幕文本" />
                                    <Button Grid.Column="4"
                                            Style="{DynamicResource Button.Text}"
                                            Content="删除"
                                            Command="{Binding DataContext.RemoveSelectedCueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="删除字幕条目" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <TextBlock Text="{Binding BlockingMessage}"
                       Style="{DynamicResource Text.Caption}"
                       Foreground="{DynamicResource Status.Failed.Text}"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap" />

            <Button Style="{DynamicResource Button.Primary}"
                    Content="烧录字幕并入队"
                    Command="{Binding RenderCommand}"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="烧录字幕并入队" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
