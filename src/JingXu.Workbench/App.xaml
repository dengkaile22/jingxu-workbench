<Application x:Class="JingXu.Workbench.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:JingXu.Workbench.Themes.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Metrics.xaml" />
                <ResourceDictionary Source="Themes/Animations/Motion.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:DownloadProgressToVisibilityConverter x:Key="DownloadProgressToVis" />
            <converters:BytesPerSecondConverter x:Key="BytesPerSecond" />
            <converters:PercentageToCanvasLengthConverter x:Key="PercentageToCanvasLength" />
            <converters:PercentageToDynamicCanvasLengthConverter x:Key="PercentageToDynamicCanvasLength" />
            <converters:EnumDisplayNameConverter x:Key="EnumDisplayName" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
