<UserControl x:Class="JingXu.Workbench.Features.Stickers.StickerEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:stickers="clr-namespace:JingXu.Workbench.Features.Stickers"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance stickers:StickerEditorViewModel}"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,16">
            <TextBlock Text="{Binding Title}" Style="{DynamicResource Text.Title}" />
            <TextBlock Text="导入 PNG/GIF 贴纸，叠加到成片画面上；可调整位置、大小、旋转与透明度。"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,8,0,0"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="贴纸素材库" Style="{DynamicResource Text.SectionHeader}" />
                    <TextBlock Text="{Binding LibraryEntries.Count, Mode=OneWay, StringFormat='{}{0} 张贴纸'}"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="生成时随机替换轨道贴纸"
                              IsChecked="{Binding UseRandomStickerLibrary, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              ToolTip="随机替换：每条成片按贴纸轨道从素材库换源，保留位置、大小、旋转与透明度；贴纸始终显示在蒙版上方。" />
                    <Button x:Name="ClearStickerLibraryButton"
                            Style="{DynamicResource Button.Secondary}"
                            Content="清空库"
                            Command="{Binding ClearStickerLibraryCommand}"
                            Margin="0,0,8,0"
                            ToolTip="一次清空贴纸素材库记录；不会删除电脑中的原始图片。"
                            AutomationProperties.Name="清空贴纸素材库" />
                    <Button Style="{DynamicResource Button.Primary}"
                            Content="导入贴纸"
                            Command="{Binding ImportStickersCommand}"
                            AutomationProperties.Name="导入贴纸" />
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="12,8"
                    Margin="0,8,0,0"
                    MaxHeight="220"
                    Visibility="{Binding HasLibraryEntries, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LibraryEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type stickers:StickerLibraryEntryRowViewModel}">
                                <Border Background="{DynamicResource Surface.Panel}"
                                        BorderBrush="{DynamicResource Line.Default}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Small}"
                                        Padding="8,6"
                                        Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="56"
                                                Height="56"
                                                Margin="0,0,10,0"
                                                Background="{DynamicResource Surface.Sunk}"
                                                BorderBrush="{DynamicResource Line.Default}"
                                                BorderThickness="1"
                                                CornerRadius="{DynamicResource Radius.Small}"
                                                ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="无图"
                                                           Style="{DynamicResource Text.Caption}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVis}}" />
                                                <Image Source="{Binding ThumbnailPath, Converter={StaticResource PathToBitmap}, ConverterParameter=112}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName, Mode=OneWay}"
                                                       Style="{DynamicResource Text.Body}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding FilePath, Mode=OneWay}"
                                                       Style="{DynamicResource Text.Mono}"
                                                       FontSize="10.5"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Style="{DynamicResource Button.Secondary}"
                                                Content="添加"
                                                Padding="10,4"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.AddStickerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="添加到贴纸轨道" />
                                        <Button Grid.Column="3"
                                                Style="{DynamicResource Button.Secondary}"
                                                Content="删除"
                                                Padding="10,4"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveLibraryStickerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="只从贴纸素材库移除，不会删除电脑中的原始图片文件。"
                                                AutomationProperties.Name="从贴纸素材库移除" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <TextBlock Text="暂无贴纸素材。点「导入贴纸」添加 PNG/GIF 到素材库。"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasLibraryEntries, Converter={StaticResource InverseBoolToVis}}" />

            <TextBlock Text="贴纸轨道" Style="{DynamicResource Text.SectionHeader}" Margin="0,18,0,8" />
            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="12,8"
                    MinHeight="80"
                    Visibility="{Binding HasTracks, Converter={StaticResource BoolToVis}}">
                <ListBox ItemsSource="{Binding Tracks}"
                         SelectedItem="{Binding SelectedTrack}"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type stickers:StickerTrackRowViewModel}">
                            <Border Background="{DynamicResource Surface.Panel}"
                                    BorderBrush="{DynamicResource Line.Default}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Small}"
                                    Padding="12,10"
                                    Margin="0,4">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalAlignment="Center"
                                                 Padding="6,4" />
                                        <Button Grid.Column="2"
                                                Style="{DynamicResource Button.Secondary}"
                                                Content="删除"
                                                Padding="10,4"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.RemoveSelectedTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                AutomationProperties.Name="删除该贴纸轨道" />
                                    </Grid>
                                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,10,0,0">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="X %" Style="{DynamicResource Text.Caption}" />
                                            <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                                        </StackPanel>
                                        <StackPanel Margin="6,0,6,0">
                                            <TextBlock Text="Y %" Style="{DynamicResource Text.Caption}" />
                                            <TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                                        </StackPanel>
                                        <StackPanel Margin="6,0,6,0">
                                            <TextBlock Text="宽 %" Style="{DynamicResource Text.Caption}" />
                                            <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                                        </StackPanel>
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="高 %" Style="{DynamicResource Text.Caption}" />
                                            <TextBox Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Grid.Row="2" Columns="2" Margin="0,10,0,0">
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="透明度 %" Style="{DynamicResource Text.Caption}" />
                                            <TextBox Text="{Binding StickerOpacity, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                                        </StackPanel>
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="旋转 °" Style="{DynamicResource Text.Caption}" />
                                            <TextBox Text="{Binding RotationDegrees, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" />
                                        </StackPanel>
                                    </UniformGrid>
                                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                        <TextBlock Text="固定比例" Style="{DynamicResource Text.Caption}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{x:Static stickers:StickerEditorViewModel.FixedAspectRatioOptions}"
                                                  SelectedValue="{Binding FixedAspectRatio}"
                                                  Padding="6,4">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumDisplayName}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock Grid.Row="4"
                                               Text="{Binding SourcePath, Mode=OneWay}"
                                               Style="{DynamicResource Text.Mono}"
                                               FontSize="10.5"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,8,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock Text="暂无贴纸轨道。从素材库点「添加」生成一条轨道。"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasTracks, Converter={StaticResource InverseBoolToVis}}" />

            <TextBlock Text="贴纸预览" Style="{DynamicResource Text.SectionHeader}" Margin="0,18,0,8" />
            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="12"
                    MinHeight="180">
                <Grid>
                    <TextBlock Text="选择一条贴纸轨道以预览效果。"
                               Style="{DynamicResource Text.Caption}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasSelectedTrack, Converter={StaticResource InverseBoolToVis}}" />
                    <Grid Visibility="{Binding HasSelectedTrack, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{DynamicResource Surface.Sunk}"
                                BorderBrush="{DynamicResource Line.Default}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Small}"
                                MinHeight="160"
                                ClipToBounds="True">
                            <Viewbox Stretch="Uniform">
                                <Canvas x:Name="PreviewCanvas"
                                        Width="{Binding PreviewCanvasWidth}"
                                        Height="{Binding PreviewCanvasHeight}"
                                        Background="{DynamicResource Surface.Sunk}"
                                        MouseLeftButtonDown="PreviewCanvas_OnMouseLeftButtonDown"
                                        MouseMove="PreviewCanvas_OnMouseMove"
                                        MouseLeftButtonUp="PreviewCanvas_OnMouseLeftButtonUp">
                                    <TextBlock Text="成片画面示意"
                                               Style="{DynamicResource Text.Caption}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <Image Source="{Binding SelectedTrack.SourcePath, Converter={StaticResource PathToBitmap}, ConverterParameter=400}"
                                           Stretch="Fill"
                                           RenderTransformOrigin="0.5,0.5">
                                        <Canvas.Left>
                                            <MultiBinding Converter="{StaticResource PercentageToDynamicCanvasLength}" ConverterParameter="X">
                                                <Binding Path="SelectedTrack.X" />
                                                <Binding Path="PreviewCanvasWidth" />
                                                <Binding Path="PreviewCanvasHeight" />
                                            </MultiBinding>
                                        </Canvas.Left>
                                        <Canvas.Top>
                                            <MultiBinding Converter="{StaticResource PercentageToDynamicCanvasLength}" ConverterParameter="Y">
                                                <Binding Path="SelectedTrack.Y" />
                                                <Binding Path="PreviewCanvasWidth" />
                                                <Binding Path="PreviewCanvasHeight" />
                                            </MultiBinding>
                                        </Canvas.Top>
                                        <Image.Width>
                                            <MultiBinding Converter="{StaticResource PercentageToDynamicCanvasLength}" ConverterParameter="Width">
                                                <Binding Path="SelectedTrack.Width" />
                                                <Binding Path="PreviewCanvasWidth" />
                                                <Binding Path="PreviewCanvasHeight" />
                                            </MultiBinding>
                                        </Image.Width>
                                        <Image.Height>
                                            <MultiBinding Converter="{StaticResource PercentageToDynamicCanvasLength}" ConverterParameter="Height">
                                                <Binding Path="SelectedTrack.Height" />
                                                <Binding Path="PreviewCanvasWidth" />
                                                <Binding Path="PreviewCanvasHeight" />
                                            </MultiBinding>
                                        </Image.Height>
                                        <Image.Opacity>
                                            <Binding Path="SelectedTrack.StickerOpacity" Converter="{StaticResource PercentageToOpacity}" />
                                        </Image.Opacity>
                                        <Image.RenderTransform>
                                            <RotateTransform Angle="{Binding SelectedTrack.RotationDegrees}" />
                                        </Image.RenderTransform>
                                    </Image>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="成片画幅示意" Style="{DynamicResource Text.Caption}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{x:Static stickers:StickerEditorViewModel.AspectModeOptions}"
                                      SelectedValue="{Binding SelectedAspectMode}"
                                      Padding="6,4"
                                      Margin="0,0,0,8"
                                      ToolTip="成片画面示意的画幅；选「跟随混剪画幅」时与混剪页统一比例同步，避免贴纸位置被裁切。轨道「固定比例」优先覆盖此处。">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumDisplayName}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding SelectedTrack.FileName, Mode=OneWay}"
                                       Style="{DynamicResource Text.Body}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{DynamicResource Text.Caption}" Margin="0,8,0,0">
                                <Run Text="位置：(" />
                                <Run Text="{Binding SelectedTrack.X, Mode=OneWay}" />
                                <Run Text="%, " />
                                <Run Text="{Binding SelectedTrack.Y, Mode=OneWay}" />
                                <Run Text="%)" />
                            </TextBlock>
                            <TextBlock Style="{DynamicResource Text.Caption}" Margin="0,4,0,0">
                                <Run Text="尺寸：" />
                                <Run Text="{Binding SelectedTrack.Width, Mode=OneWay}" />
                                <Run Text="% × " />
                                <Run Text="{Binding SelectedTrack.Height, Mode=OneWay}" />
                                <Run Text="%" />
                            </TextBlock>
                            <TextBlock Style="{DynamicResource Text.Caption}" Margin="0,4,0,0">
                                <Run Text="透明度：" />
                                <Run Text="{Binding SelectedTrack.StickerOpacity, Mode=OneWay}" />
                                <Run Text="%" />
                            </TextBlock>
                            <TextBlock Style="{DynamicResource Text.Caption}" Margin="0,4,0,0">
                                <Run Text="旋转：" />
                                <Run Text="{Binding SelectedTrack.RotationDegrees, Mode=OneWay}" />
                                <Run Text="°" />
                            </TextBlock>
                            <TextBlock Text="拖拽预览中的贴纸可调整位置"
                                       Style="{DynamicResource Text.Caption}"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
