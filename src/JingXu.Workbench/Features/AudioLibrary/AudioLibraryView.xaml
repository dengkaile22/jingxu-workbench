<UserControl x:Class="JingXu.Workbench.Features.AudioLibrary.AudioLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:audio="clr-namespace:JingXu.Workbench.Features.AudioLibrary"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance audio:AudioLibraryViewModel}"
             Background="Transparent">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 操作栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="音频库" Style="{DynamicResource Text.Heading}" VerticalAlignment="Center" />
                <Border Background="{DynamicResource Surface.Sunk}"
                        CornerRadius="4"
                        Padding="7,2"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding EntryCount, StringFormat={}{0} 条}" FontSize="11"
                               FontFamily="{DynamicResource Font.Mono}" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{DynamicResource TitleBar.IconButton}"
                        Width="32" Height="32"
                        Content="⟳"
                        Command="{Binding RefreshCommand}"
                        Margin="0,0,6,0"
                        AutomationProperties.Name="刷新音频库" />
                <Button Style="{DynamicResource Button.Secondary}"
                        Content="一键清库"
                        Command="{Binding ClearAllCommand}"
                        Margin="0,0,8,0"
                        Padding="12,6"
                        AutomationProperties.Name="一键清空音频库"
                        ToolTip="清空全部音频库条目（弹确认框，不删除电脑中的原文件）" />
                <Button Style="{DynamicResource Button.Primary}"
                        Content="导入音频"
                        Command="{Binding ImportAudioFilesCommand}"
                        AutomationProperties.Name="导入音频文件" />
            </StackPanel>
        </Grid>

        <!-- 提示信息 -->
        <Border Grid.Row="1"
                Background="{DynamicResource Surface.PanelMuted}"
                BorderBrush="{DynamicResource Line.Default}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,0,0,12"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding StatusMessage}" Style="{DynamicResource Text.Caption}" TextWrapping="Wrap" />
        </Border>

        <!-- 空状态 -->
        <StackPanel Grid.Row="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding HasEntries, Converter={StaticResource InverseBoolToVis}}">
            <TextBlock Text="音频库为空" Style="{DynamicResource Text.Body}" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="导入 MP3、WAV、M4A、AAC、FLAC、OGG 等音频文件后，可在混剪页开启「随机选取音频库」，每个渲染任务自动抽取一条背景音乐。"
                       Style="{DynamicResource Text.Caption}" HorizontalAlignment="Center"
                       TextWrapping="Wrap" Width="400" TextAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <!-- 列表 -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding LibraryEntries}"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Visibility="{Binding HasEntries, Converter={StaticResource BoolToVis}}"
                 AutomationProperties.Name="音频库列表">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="RowBorder"
                                        Background="{DynamicResource Surface.PanelMuted}"
                                        BorderBrush="{DynamicResource Line.Default}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="14,10">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource Brand.Bloom}" />
                                        <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Surface.Sunk}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Surface.Sunk}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type audio:AudioLibraryEntryRowViewModel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🎵" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding DurationText}" Style="{DynamicResource Text.Caption}"
                                           FontFamily="{DynamicResource Font.Mono}" />
                                <TextBlock Text=" · " Style="{DynamicResource Text.Caption}" />
                                <TextBlock Text="{Binding StatusLabel}" Style="{DynamicResource Text.Caption}" />
                                <TextBlock Text=" · " Style="{DynamicResource Text.Caption}" />
                                <TextBlock Text="{Binding LastUsedText}" Style="{DynamicResource Text.Caption}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding FileName}"
                                   Style="{DynamicResource Text.Caption}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,12,0"
                                   Foreground="{DynamicResource Ink.Muted}" />

                        <Button Grid.Column="3"
                                Style="{DynamicResource TitleBar.IconButton}"
                                Width="28" Height="28"
                                Content="{DynamicResource Icon.Win.Close}"
                                Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.RemoveEntryCommand}"
                                CommandParameter="{Binding}"
                                AutomationProperties.Name="删除此音频" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
