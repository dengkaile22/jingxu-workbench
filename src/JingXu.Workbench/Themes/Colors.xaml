<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 镜台 · 精密光学编排台 调色板
         暖灰阳极氧化机身 + 唯一深色中央取景井 + 深墨绿增透膜冷光。
         每个色值提供 Color（供动效）与 SolidColorBrush（供绑定）两种资源。 -->

    <!-- ── 机身表面（暖灰阳极氧化）───────────────────────────────── -->
    <Color x:Key="Surface.Canvas.Color">#F3F1EA</Color>
    <Color x:Key="Surface.Panel.Color">#FCFBF7</Color>
    <Color x:Key="Surface.PanelMuted.Color">#FBFAF5</Color>
    <Color x:Key="Surface.Rail.Color">#ECEAE1</Color>
    <Color x:Key="Surface.Sunk.Color">#E6E3DA</Color>

    <SolidColorBrush x:Key="Surface.Canvas" Color="{StaticResource Surface.Canvas.Color}" />
    <SolidColorBrush x:Key="Surface.Panel" Color="{StaticResource Surface.Panel.Color}" />
    <SolidColorBrush x:Key="Surface.PanelMuted" Color="{StaticResource Surface.PanelMuted.Color}" />
    <SolidColorBrush x:Key="Surface.Rail" Color="{StaticResource Surface.Rail.Color}" />
    <SolidColorBrush x:Key="Surface.Sunk" Color="{StaticResource Surface.Sunk.Color}" />

    <!-- ── 中央取景井（唯一深色区域）─────────────────────────────── -->
    <Color x:Key="Gate.Well.Color">#101B17</Color>
    <Color x:Key="Gate.WellDeep.Color">#0B1411</Color>
    <Color x:Key="Brand.Bloom.Color">#49A588</Color>

    <SolidColorBrush x:Key="Gate.Well" Color="{StaticResource Gate.Well.Color}" />
    <SolidColorBrush x:Key="Gate.WellDeep" Color="{StaticResource Gate.WellDeep.Color}" />
    <SolidColorBrush x:Key="Brand.Bloom" Color="{StaticResource Brand.Bloom.Color}" />

    <!-- 取景井上的文字（深底浅字）-->
    <Color x:Key="On.Gate.Color">#C6CEC8</Color>
    <Color x:Key="On.Gate.Muted.Color">#7E8C85</Color>
    <SolidColorBrush x:Key="On.Gate" Color="{StaticResource On.Gate.Color}" />
    <SolidColorBrush x:Key="On.Gate.Muted" Color="{StaticResource On.Gate.Muted.Color}" />

    <!-- ── 主色（深墨绿）───────────────────────────────────────── -->
    <Color x:Key="Brand.Primary.Color">#246B59</Color>
    <Color x:Key="Brand.PrimaryHover.Color">#1C5748</Color>
    <Color x:Key="Brand.PrimaryPressed.Color">#16463A</Color>

    <SolidColorBrush x:Key="Brand.Primary" Color="{StaticResource Brand.Primary.Color}" />
    <SolidColorBrush x:Key="Brand.PrimaryHover" Color="{StaticResource Brand.PrimaryHover.Color}" />
    <SolidColorBrush x:Key="Brand.PrimaryPressed" Color="{StaticResource Brand.PrimaryPressed.Color}" />

    <!-- 主色之上的文字（暖白）-->
    <Color x:Key="On.Brand.Color">#F4F6F1</Color>
    <SolidColorBrush x:Key="On.Brand" Color="{StaticResource On.Brand.Color}" />

    <!-- ── 墨色文字 ───────────────────────────────────────────── -->
    <Color x:Key="Ink.Primary.Color">#17231F</Color>
    <Color x:Key="Ink.Muted.Color">#68736E</Color>

    <SolidColorBrush x:Key="Ink.Primary" Color="{StaticResource Ink.Primary.Color}" />
    <SolidColorBrush x:Key="Ink.Muted" Color="{StaticResource Ink.Muted.Color}" />

    <!-- ── 分隔线 ─────────────────────────────────────────────── -->
    <Color x:Key="Line.Default.Color">#D6D5CF</Color>
    <Color x:Key="Line.Strong.Color">#C3C2B9</Color>

    <SolidColorBrush x:Key="Line.Default" Color="{StaticResource Line.Default.Color}" />
    <SolidColorBrush x:Key="Line.Strong" Color="{StaticResource Line.Strong.Color}" />

    <!-- ── 状态（克制的琥珀 / 暗红）──────────────────────────────── -->
    <Color x:Key="Status.Running.Color">#C9823C</Color>
    <Color x:Key="Status.Running.Text.Color">#8A5A28</Color>
    <Color x:Key="Status.Failed.Color">#A8463F</Color>

    <SolidColorBrush x:Key="Status.Running" Color="{StaticResource Status.Running.Color}" />
    <SolidColorBrush x:Key="Status.Running.Text" Color="{StaticResource Status.Running.Text.Color}" />
    <SolidColorBrush x:Key="Status.Failed" Color="{StaticResource Status.Failed.Color}" />

    <!-- 键盘焦点环 -->
    <Color x:Key="Focus.Ring.Color">#246B59</Color>
    <SolidColorBrush x:Key="Focus.Ring" Color="{StaticResource Focus.Ring.Color}" />

</ResourceDictionary>
