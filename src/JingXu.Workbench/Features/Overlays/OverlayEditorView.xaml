<UserControl x:Class="JingXu.Workbench.Features.Overlays.OverlayEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overlays="clr-namespace:JingXu.Workbench.Features.Overlays"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance overlays:OverlayEditorViewModel}"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,16">
            <TextBlock Text="{Binding Title}" Style="{DynamicResource Text.Title}" />
            <TextBlock Text="{Binding PreviewSummary}"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />

            <TextBlock Text="{Binding StatusMessage}"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,8,0,0"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="蒙版素材库" Style="{DynamicResource Text.SectionHeader}" />
                    <TextBlock Text="{Binding LibraryCountLabel, Mode=OneWay}"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,4,0,0" />
                    <TextBlock Text="上方为随机替换素材库；下方当前选中的外部蒙版轨道保存位置与起始片段等参数。开启后，每条成片只随机替换 1 个蒙版，不会把多个蒙版堆叠。"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="生成时随机替换 1 个素材库蒙版"
                              IsChecked="{Binding UseRandomMaskLibrary, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              ToolTip="随机替换：每条成片从素材库选择 1 个蒙版，沿用当前选中轨道的位置、尺寸、透明度、羽化与起始片段。" />
                    <Button Style="{DynamicResource Button.Secondary}"
                            Content="清理失效"
                            Command="{Binding PruneMissingLibraryEntriesCommand}"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="清理失效蒙版素材库条目" />
                    <Button Style="{DynamicResource Button.Secondary}"
                            Content="清空库"
                            Command="{Binding ClearLibraryEntriesCommand}"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="清空蒙版素材库" />
                    <Button Style="{DynamicResource Button.Primary}"
                            Content="导入蒙版素材"
                            Command="{Binding ImportMaskMaterialsCommand}"
                            AutomationProperties.Name="导入蒙版素材" />
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="12,8"
                    Margin="0,8,0,0"
                    MaxHeight="220"
                    Visibility="{Binding HasLibraryEntries, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding LibraryEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type overlays:OverlayLibraryEntryRowViewModel}">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="56"
                                            Height="56"
                                            Margin="0,0,10,0"
                                            Background="{DynamicResource Surface.Sunk}"
                                            BorderBrush="{DynamicResource Line.Default}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource Radius.Small}"
                                            ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="无图"
                                                       Style="{DynamicResource Text.Caption}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVis}}" />
                                            <Image Source="{Binding ThumbnailPath, Converter={StaticResource PathToBitmap}, ConverterParameter=112}"
                                                   Stretch="UniformToFill"
                                                   Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding FileName, Mode=OneWay}"
                                                   Style="{DynamicResource Text.Body}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding FilePath, Mode=OneWay}"
                                                   Style="{DynamicResource Text.Mono}"
                                                   FontSize="10.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{DynamicResource Text.Caption}" Margin="0,2,0,0">
                                            <Run Text="{Binding TagsText, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding LastUsedText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            Background="{DynamicResource Surface.Sunk}"
                                            BorderBrush="{DynamicResource Line.Default}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource Radius.Small}"
                                            Padding="8,3"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0">
                                        <TextBlock Text="{Binding StatusLabel, Mode=OneWay}"
                                                   Style="{DynamicResource Text.Caption}"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <Button Grid.Column="3"
                                            Style="{DynamicResource Button.Secondary}"
                                            Content="删除"
                                            Padding="10,4"
                                            VerticalAlignment="Center"
                                            Command="{Binding DataContext.DeleteLibraryEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="删除该蒙版素材库条目" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <TextBlock Text="蒙版轨道"
                       Style="{DynamicResource Text.SectionHeader}"
                       Margin="0,14,0,0"
                       Visibility="{Binding HasLayers, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="轨道保存位置、尺寸与起始片段等参数；开启随机替换后，每条成片沿用当前选中轨道参数并替换素材。"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasLayers, Converter={StaticResource BoolToVis}}" />
            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="12,8"
                    Margin="0,8,0,0"
                    MinHeight="80"
                    Visibility="{Binding HasLayers, Converter={StaticResource BoolToVis}}">
                <ListBox ItemsSource="{Binding Layers}"
                         SelectedItem="{Binding Selected}"
                         BorderThickness="0"
                         Background="Transparent">
                    <!-- Run.Text 默认 TwoWay：只读行属性必须显式 OneWay，否则添加层后会抛绑定异常并弹「操作失败」。 -->
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type overlays:OverlayLayerRowViewModel}">
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding DisplayName, Mode=OneWay}"
                                               Style="{DynamicResource Text.Body}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SourceFileName, Mode=OneWay}"
                                               Style="{DynamicResource Text.Caption}" />
                                    <TextBlock Text="{Binding BoundsText, Mode=OneWay}"
                                               Style="{DynamicResource Text.Mono}"
                                               FontSize="11" />
                                    <TextBlock Text="{Binding TransformText, Mode=OneWay}"
                                               Style="{DynamicResource Text.Mono}"
                                               FontSize="11" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Style="{DynamicResource Text.Caption}"
                                           VerticalAlignment="Center">
                                    <Run Text="Z" />
                                    <Run Text="{Binding ZIndex, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock Text="暂无蒙版。点「导入蒙版素材」叠入外部视频；默认放在上半红框区并带中间→上渐变。"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasLayers, Converter={StaticResource InverseBoolToVis}}" />

            <TextBlock Text="蒙版区域预览" Style="{DynamicResource Text.SectionHeader}" Margin="0,18,0,8" />
            <TextBlock Text="接近成片的静帧示意：暗红框为默认上半叠区；蓝框只控制成片中的输出位置和尺寸，可拖中心平移、拖边/角改大小。旁边的白框独立控制源素材取景。"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,0,0,6"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding PreviewInteractionHint}"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,0,0,4"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding PreviewVisualEffectHint}"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,0,0,10"
                       TextWrapping="Wrap" />
            <WrapPanel Margin="0,0,0,8">
                <Border Background="{DynamicResource Surface.PanelMuted}"
                        BorderBrush="{DynamicResource Line.Default}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Standard}"
                        Padding="12"
                        HorizontalAlignment="Left"
                        ClipToBounds="True"
                        Margin="0,0,16,0">
                    <Canvas x:Name="MaskPreviewCanvas"
                            Width="216"
                            Height="384"
                            ClipToBounds="True"
                            Background="#FF1A1A22"
                            MouseLeftButtonDown="MaskPreviewCanvas_OnMouseLeftButtonDown"
                            MouseMove="MaskPreviewCanvas_OnMouseMove"
                            MouseLeftButtonUp="MaskPreviewCanvas_OnMouseLeftButtonUp"
                            LostMouseCapture="MaskPreviewCanvas_OnLostMouseCapture">
                        <!-- 默认上半红框参考区（与 ImportedMaskBounds 对齐） -->
                        <Border Width="194.4"
                                Height="161.28"
                                BorderBrush="#99E85D5C"
                                BorderThickness="1.5"
                                Background="#22E85D5C"
                                Canvas.Left="10.8"
                                Canvas.Top="19.2"
                                IsHitTestVisible="False" />
                        <Border x:Name="MaskPreviewFrame"
                                Width="{Binding PreviewMaskWidth}"
                                Height="{Binding PreviewMaskHeight}"
                                BorderBrush="#FF4DA3FF"
                                BorderThickness="2"
                                Background="Transparent"
                                Canvas.Left="{Binding PreviewMaskRenderLeft}"
                                Canvas.Top="{Binding PreviewMaskRenderTop}"
                                Visibility="{Binding HasSelected, Converter={StaticResource BoolToVis}}"
                                Cursor="SizeAll"
                                ClipToBounds="True"
                                ToolTip="{Binding PreviewVisualEffectHint}"
                                RenderTransformOrigin="0.5,0.5"
                                MouseLeftButtonDown="MaskPreviewFrame_OnMouseLeftButtonDown">
                            <Border.RenderTransform>
                                <RotateTransform Angle="{Binding RotationDegrees}" />
                            </Border.RenderTransform>
                            <Grid>
                                <Image Source="{Binding SelectedMaskThumbnailPath, Converter={StaticResource PathToBitmap}, ConverterParameter=432}"
                                       Stretch="UniformToFill"
                                       Opacity="{Binding PreviewMaskFillOpacity}"
                                       Visibility="{Binding HasSelectedMaskThumbnail, Converter={StaticResource BoolToVis}}"
                                       IsHitTestVisible="False" />
                                <Border Opacity="{Binding PreviewMaskFillOpacity}"
                                        Panel.ZIndex="1"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                            <GradientStop Color="#804DA3FF" Offset="0" />
                                            <GradientStop Color="#804DA3FF" Offset="{Binding PreviewTopFadeSolidStopOffset}" />
                                            <GradientStop Color="#004DA3FF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <BlurEffect Radius="{Binding PreviewFeatherBlurRadius}" />
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                    </Canvas>
                </Border>
                <StackPanel VerticalAlignment="Top" Width="216" Margin="0,0,16,0">
                    <TextBlock Text="源素材取景"
                               Style="{DynamicResource Text.Caption}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" />
                    <Border Width="216"
                            Height="384"
                            Background="{DynamicResource Surface.Sunk}"
                            BorderBrush="{DynamicResource Line.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Small}"
                            ClipToBounds="True">
                        <Canvas x:Name="SourceCropPreviewCanvas"
                                Width="216"
                                Height="384"
                                ClipToBounds="True"
                                Background="#FF1A1A22"
                                MouseLeftButtonDown="SourceCropPreviewCanvas_OnMouseLeftButtonDown"
                                MouseMove="SourceCropPreviewCanvas_OnMouseMove"
                                MouseLeftButtonUp="SourceCropPreviewCanvas_OnMouseLeftButtonUp"
                                LostMouseCapture="SourceCropPreviewCanvas_OnLostMouseCapture"
                                AutomationProperties.Name="源素材取景画布">
                            <TextBlock Text="暂无源素材预览"
                                       Style="{DynamicResource Text.Caption}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Width="216"
                                       Height="384"
                                       TextAlignment="Center"
                                       Visibility="{Binding HasSelectedMaskThumbnail, Converter={StaticResource InverseBoolToVis}}"
                                       IsHitTestVisible="False" />
                            <Image Source="{Binding SelectedMaskThumbnailPath, Converter={StaticResource PathToBitmap}, ConverterParameter=432}"
                                   Width="216"
                                   Height="384"
                                   Stretch="Fill"
                                   Visibility="{Binding HasSelectedMaskThumbnail, Converter={StaticResource BoolToVis}}"
                                   IsHitTestVisible="False" />
                            <Border x:Name="SourceCropPreviewFrame"
                                    Width="{Binding SourceCropPreviewWidth}"
                                    Height="{Binding SourceCropPreviewHeight}"
                                    BorderBrush="#FFFFFFFF"
                                    BorderThickness="2"
                                    Background="#22FFFFFF"
                                    Canvas.Left="{Binding SourceCropPreviewLeft}"
                                    Canvas.Top="{Binding SourceCropPreviewTop}"
                                    Visibility="{Binding HasSelected, Converter={StaticResource BoolToVis}}"
                                    Cursor="SizeAll"
                                    MouseLeftButtonDown="SourceCropPreviewFrame_OnMouseLeftButtonDown"
                                    AutomationProperties.Name="拖动或缩放源素材取景框">
                                <TextBlock Text="源取景"
                                           Style="{DynamicResource Text.Caption}"
                                           Foreground="White"
                                           Margin="6"
                                           IsHitTestVisible="False" />
                            </Border>
                        </Canvas>
                    </Border>
                    <TextBlock Text="{Binding SourceCropInteractionHint}"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel VerticalAlignment="Top" Width="220">
                    <TextBlock Text="真实合成静帧"
                               Style="{DynamicResource Text.Caption}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" />
                    <WrapPanel Margin="0,0,0,6">
                        <Button Style="{DynamicResource Button.Secondary}"
                                Content="选择预览主片"
                                Command="{Binding ChooseEffectPreviewBaseVideoCommand}"
                                AutomationProperties.Name="选择叠层静帧预览主片"
                                Margin="0,0,6,6" />
                        <Button Style="{DynamicResource Button.Secondary}"
                                Content="刷新合成预览"
                                Command="{Binding RefreshEffectPreviewFromBaseVideoCommand}"
                                AutomationProperties.Name="刷新真实叠层静帧预览"
                                Margin="0,0,0,6" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="预览主片：" Style="{DynamicResource Text.Caption}" />
                        <TextBlock Text="{Binding EffectPreviewBaseVideoName}"
                                   Style="{DynamicResource Text.Caption}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="148" />
                    </StackPanel>
                    <Border Width="216"
                            Height="384"
                            Background="{DynamicResource Surface.Sunk}"
                            BorderBrush="{DynamicResource Line.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Small}"
                            ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="暂无预览"
                                       Style="{DynamicResource Text.Caption}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasEffectPreviewImage, Converter={StaticResource InverseBoolToVis}}" />
                            <Image Source="{Binding EffectPreviewImagePath, Converter={StaticResource PathToBitmap}, ConverterParameter=432}"
                                   Stretch="Uniform"
                                   Visibility="{Binding HasEffectPreviewImage, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding EffectPreviewHint}"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </WrapPanel>

            <TextBlock Text="选中层参数" Style="{DynamicResource Text.SectionHeader}" Margin="0,24,0,10" />
            <Grid IsEnabled="{Binding HasSelected}" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                    <TextBlock Text="X" Style="{DynamicResource Text.Caption}" />
                    <TextBox Text="{Binding BoundsX, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                    <TextBlock Text="Y" Style="{DynamicResource Text.Caption}" />
                    <TextBox Text="{Binding BoundsY, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                    <TextBlock Text="宽度" Style="{DynamicResource Text.Caption}" />
                    <TextBox Text="{Binding BoundsWidth, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                    <TextBlock Text="高度" Style="{DynamicResource Text.Caption}" />
                    <TextBox Text="{Binding BoundsHeight, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,8">
                    <TextBlock Text="输出叠层框比例" Style="{DynamicResource Text.Caption}" Margin="0,0,0,2" />
                    <TextBlock Text="只调整蓝色输出框的宽高，不改变源素材取景。"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,0,0,6" />
                    <WrapPanel>
                        <Button Style="{DynamicResource Button.Secondary}"
                                Content="自由"
                                Margin="0,0,6,6"
                                Command="{Binding ApplyMaskAspectPresetCommand}"
                                CommandParameter="自由"
                                AutomationProperties.Name="蒙版比例自由" />
                        <Button Style="{DynamicResource Button.Secondary}"
                                Content="9:16"
                                Margin="0,0,6,6"
                                Command="{Binding ApplyMaskAspectPresetCommand}"
                                CommandParameter="9:16"
                                AutomationProperties.Name="蒙版比例9比16" />
                        <Button Style="{DynamicResource Button.Secondary}"
                                Content="16:9"
                                Margin="0,0,6,6"
                                Command="{Binding ApplyMaskAspectPresetCommand}"
                                CommandParameter="16:9"
                                AutomationProperties.Name="蒙版比例16比9" />
                        <Button Style="{DynamicResource Button.Secondary}"
                                Content="1:1"
                                Margin="0,0,6,6"
                                Command="{Binding ApplyMaskAspectPresetCommand}"
                                CommandParameter="1:1"
                                AutomationProperties.Name="蒙版比例1比1" />
                        <Button Style="{DynamicResource Button.Secondary}"
                                Content="4:5"
                                Margin="0,0,6,6"
                                Command="{Binding ApplyMaskAspectPresetCommand}"
                                CommandParameter="4:5"
                                AutomationProperties.Name="蒙版比例4比5" />
                        <Button Style="{DynamicResource Button.Secondary}"
                                Content="3:4"
                                Margin="0,0,6,6"
                                Command="{Binding ApplyMaskAspectPresetCommand}"
                                CommandParameter="3:4"
                                AutomationProperties.Name="蒙版比例3比4" />
                        <Button Style="{DynamicResource Button.Secondary}"
                                Content="统一尺寸到全部层"
                                Margin="0,0,6,6"
                                Command="{Binding ApplyUnifiedSizeToAllCommand}"
                                AutomationProperties.Name="统一蒙版尺寸到全部层" />
                    </WrapPanel>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,8">
                    <TextBlock Text="源素材适配" Style="{DynamicResource Text.Caption}" Margin="0,0,0,6" />
                    <WrapPanel>
                        <Button Style="{DynamicResource Button.Secondary}"
                                Content="填满裁切"
                                Margin="0,0,6,6"
                                Command="{Binding ApplyFitPresetCommand}"
                                CommandParameter="FillCrop"
                                AutomationProperties.Name="源素材适配填满裁切" />
                        <Button Style="{DynamicResource Button.Secondary}"
                                Content="完整适配"
                                Margin="0,0,6,6"
                                Command="{Binding ApplyFitPresetCommand}"
                                CommandParameter="Contain"
                                AutomationProperties.Name="源素材适配完整适配" />
                        <Button Style="{DynamicResource Button.Secondary}"
                                Content="拉伸"
                                Margin="0,0,6,6"
                                Command="{Binding ApplyFitPresetCommand}"
                                CommandParameter="Stretch"
                                AutomationProperties.Name="源素材适配拉伸" />
                        <Button Style="{DynamicResource Button.Secondary}"
                                Content="裁成画幅再覆盖"
                                Margin="0,0,6,6"
                                Command="{Binding ApplyFitPresetCommand}"
                                CommandParameter="MatchCanvasCrop"
                                AutomationProperties.Name="源素材适配裁成画幅再覆盖" />
                    </WrapPanel>
                    <TextBlock Text="{Binding FitInteractionHint}"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,0,0,2"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,8,8">
                    <TextBlock Text="透明度（0–100%）" Style="{DynamicResource Text.Caption}" />
                    <TextBox Text="{Binding OpacityPercent, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6"
                             AutomationProperties.Name="蒙版透明度百分比" />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="8,0,0,8">
                    <TextBlock Text="起始片段" Style="{DynamicResource Text.Caption}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding StartClipIndex, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 AutomationProperties.Name="蒙版起始片段" />
                        <Button Grid.Column="1"
                                Style="{DynamicResource Button.Secondary}"
                                Content="统一到全部轨道"
                                Command="{Binding ApplyStartClipIndexToAllLayersCommand}"
                                Margin="8,0,0,0"
                                ToolTip="只统一起始片段，不修改其他蒙版参数。"
                                AutomationProperties.Name="统一起始片段到全部轨道" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,4,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="尺寸" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Width="40" />
                        <Slider Grid.Column="1"
                                Minimum="0.01"
                                Maximum="4"
                                Value="{Binding Scale}"
                                TickFrequency="0.1"
                                IsSnapToTickEnabled="False"
                                Margin="8,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Scale, StringFormat={}{0:P0}}"
                                   Style="{DynamicResource Text.Mono}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,0,0,8">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="位置 X" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Width="40" />
                        <Slider Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding OffsetX}" Margin="8,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding OffsetX, StringFormat={}{0:0.##}}"
                                   Style="{DynamicResource Text.Mono}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="位置 Y" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Width="40" />
                        <Slider Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding OffsetY}" Margin="8,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding OffsetY, StringFormat={}{0:0.##}}"
                                   Style="{DynamicResource Text.Mono}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="7" Grid.ColumnSpan="2">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="旋转" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Width="56" />
                        <Slider Grid.Column="1" Minimum="-180" Maximum="180" Value="{Binding RotationDegrees}" Margin="8,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding RotationDegrees, StringFormat={}{0:0.#}°}"
                                   Style="{DynamicResource Text.Mono}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="自动上下偏移" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Width="72"
                                   ToolTip="未设置手动源素材取景时，蒙版源裁成画幅比例的上下选取（-1 偏上 / 0 居中 / 1 偏下）。混剪页选「裁成画幅再覆盖」时生效。" />
                        <Slider Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding SourceCropY}" Margin="8,0"
                                AutomationProperties.Name="自动源素材上下选取偏移" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding SourceCropY, StringFormat={}{0:0.##}}"
                                   Style="{DynamicResource Text.Mono}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="分割位置" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Width="56"
                                   ToolTip="线性蒙版分割线：蒙版覆盖到画面多深（归一化底边）。" />
                        <Slider Grid.Column="1" Minimum="0.15" Maximum="1" Value="{Binding SplitPosition}" Margin="8,0"
                                AutomationProperties.Name="蒙版分割位置" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding SplitPosition, StringFormat={}{0:0.##}}"
                                   Style="{DynamicResource Text.Mono}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="上向渐变" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Width="56"
                                   ToolTip="覆盖区内自底实向顶淡的垂直渐变强度。" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding TopFade}" Margin="8,0"
                                AutomationProperties.Name="蒙版上向渐变" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding TopFade, StringFormat={}{0:0.##}}"
                                   Style="{DynamicResource Text.Mono}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="羽化" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Width="56"
                                   ToolTip="分割线软过渡 + 边缘虚化。" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Feather}" Margin="8,0"
                                AutomationProperties.Name="蒙版羽化" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Feather, StringFormat={}{0:P0}}"
                                   Style="{DynamicResource Text.Mono}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Border IsEnabled="{Binding HasSelected}"
                    Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Small}"
                    Padding="12"
                    Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="源素材取景（独立于输出叠层框）"
                               Style="{DynamicResource Text.SectionHeader}" />
                    <TextBlock Text="手动填写或拖动白框；手动取景优先于“自动上下选取偏移”。重置后恢复自动选取。"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,4,0,10"
                               TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="X" Style="{DynamicResource Text.Caption}" />
                            <TextBox Text="{Binding SourceCropBoundsX, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6"
                                     AutomationProperties.Name="源素材取景X" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                            <TextBlock Text="Y" Style="{DynamicResource Text.Caption}" />
                            <TextBox Text="{Binding SourceCropBoundsY, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6"
                                     AutomationProperties.Name="源素材取景Y" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="宽度" Style="{DynamicResource Text.Caption}" />
                            <TextBox Text="{Binding SourceCropBoundsWidth, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6"
                                     AutomationProperties.Name="源素材取景宽度" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="高度" Style="{DynamicResource Text.Caption}" />
                            <TextBox Text="{Binding SourceCropBoundsHeight, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6"
                                     AutomationProperties.Name="源素材取景高度" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{DynamicResource Button.Secondary}"
                                Content="重置为自动取景"
                                Command="{Binding ResetSourceCropBoundsCommand}"
                                Margin="0,0,8,0"
                                AutomationProperties.Name="重置源素材取景为自动" />
                        <TextBlock Text="{Binding SourceCropInteractionHint}"
                                   Style="{DynamicResource Text.Caption}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,8,0,0">
                <CheckBox Content="混入蒙版音轨"
                          IsChecked="{Binding MixOverlayAudio}"
                          IsEnabled="{Binding HasSelected}"
                          Margin="0,0,16,8"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="混入蒙版音轨到成片" />
                <Button Style="{DynamicResource Button.Secondary}"
                        Content="应用参数"
                        Command="{Binding ApplyBoundsCommand}"
                        Margin="0,0,8,8"
                        AutomationProperties.Name="应用蒙版参数到选中层" />
                <Button Style="{DynamicResource Button.Secondary}"
                        Content="统一应用到所有轨道"
                        Command="{Binding ApplyCurrentVisualSettingsToAllLayersCommand}"
                        Margin="0,0,8,8"
                        ToolTip="{Binding ApplyCurrentVisualSettingsToAllLayersHint}"
                        AutomationProperties.Name="将当前蒙版参数统一应用到所有轨道" />
                <Button Style="{DynamicResource Button.Secondary}"
                        Content="移除选中"
                        Command="{Binding RemoveSelectedCommand}"
                        AutomationProperties.Name="移除选中蒙版层" />
            </WrapPanel>

            <TextBlock Text="{Binding ApplyCurrentVisualSettingsToAllLayersHint}"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,0,0,4"
                       TextWrapping="Wrap" />

            <TextBlock Text="配置完成后，在混剪页开启「启用蒙版覆盖到成片」。商品为 3:4、蒙版为 9:16 时：混剪页选 3:4 画幅（自动「裁成画幅再覆盖」），本页优先用「源素材取景」选人；未手动取景时可用「自动上下偏移」调整选取，再用「分割位置」调上下分界、「羽化」软化分割线。"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,16,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
