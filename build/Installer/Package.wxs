<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="JingXu Workbench" />
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="B1C2D3E4-F5A6-7890-BCDE-F12345678901">
        <File Id="JingXu.Workbench.exe" Source="$(var.PublishDir)\JingXu.Workbench.exe" KeyPath="yes" />
      </Component>
      <Component Id="Readme" Guid="C2D3E4F5-A6B7-8901-CDEF-123456789012">
        <File Id="ReadmeFile" Source="$(var.PublishDir)\README.md" />
      </Component>
      <Component Id="Notices" Guid="D3E4F5A6-B7C8-9012-DEF0-234567890123">
        <File Id="NoticesFile" Source="$(var.PublishDir)\THIRD_PARTY_NOTICES.md" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
