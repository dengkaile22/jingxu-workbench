<UserControl x:Class="JingXu.Workbench.Features.Overlays.OverlayEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:overlays="clr-namespace:JingXu.Workbench.Features.Overlays"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance overlays:OverlayEditorViewModel}"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,16">
            <TextBlock Text="{Binding Title}" Style="{DynamicResource Text.Title}" />
            <TextBlock Text="{Binding PreviewSummary}"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />

            <TextBlock Text="{Binding StatusMessage}"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,8,0,0"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}" />

            <WrapPanel Margin="0,18,0,0">
                <Button Style="{DynamicResource Button.Primary}"
                        Content="导入蒙版素材"
                        Command="{Binding ImportMaskMaterialsCommand}"
                        Margin="0,0,8,8"
                        AutomationProperties.Name="导入蒙版素材" />
            </WrapPanel>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="蒙版列表" Style="{DynamicResource Text.SectionHeader}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Style="{DynamicResource Text.Caption}"
                           VerticalAlignment="Center">
                    <Run Text="素材库 " />
                    <Run Text="{Binding LibraryEntryCount, Mode=OneWay}" />
                    <Run Text=" 条" />
                </TextBlock>
            </Grid>

            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="12,8"
                    Margin="0,8,0,0"
                    MinHeight="80"
                    Visibility="{Binding HasLayers, Converter={StaticResource BoolToVis}}">
                <ListBox ItemsSource="{Binding Layers}"
                         SelectedItem="{Binding Selected}"
                         BorderThickness="0"
                         Background="Transparent">
                    <!-- Run.Text 默认 TwoWay：只读行属性必须显式 OneWay，否则添加层后会抛绑定异常并弹「操作失败」。 -->
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type overlays:OverlayLayerRowViewModel}">
                            <StackPanel Margin="0,4">
                                <TextBlock Style="{DynamicResource Text.Body}">
                                    <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding ModeLabel, Mode=OneWay}" />
                                    <Run Text=" · Z" />
                                    <Run Text="{Binding ZIndex, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding SourceFileName, Mode=OneWay}" Style="{DynamicResource Text.Caption}" />
                                <TextBlock Text="{Binding BoundsText, Mode=OneWay}" Style="{DynamicResource Text.Mono}" FontSize="11" />
                                <TextBlock Text="{Binding TransformText, Mode=OneWay}" Style="{DynamicResource Text.Mono}" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock Text="暂无蒙版素材。点击「导入蒙版素材」选择视频文件，将加入列表并写入素材库。"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasLayers, Converter={StaticResource InverseBoolToVis}}" />

            <TextBlock Text="镜台预览" Style="{DynamicResource Text.SectionHeader}" Margin="0,18,0,8" />
            <TextBlock Text="预览为竖屏镜台示意，反映边界、缩放、位移与旋转。"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,0,0,10"
                       TextWrapping="Wrap" />
            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="12"
                    HorizontalAlignment="Left"
                    ClipToBounds="True"
                    Margin="0,0,0,4">
                <Canvas Width="180"
                        Height="320"
                        ClipToBounds="True"
                        Background="#FF1A1A22">
                    <Border Width="{Binding PreviewMaskWidth}"
                            Height="{Binding PreviewMaskHeight}"
                            BorderBrush="#FF4DA3FF"
                            BorderThickness="2"
                            Background="#334DA3FF"
                            Canvas.Left="{Binding PreviewMaskRenderLeft}"
                            Canvas.Top="{Binding PreviewMaskRenderTop}"
                            Visibility="{Binding HasSelected, Converter={StaticResource BoolToVis}}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <RotateTransform Angle="{Binding RotationDegrees}" />
                        </Border.RenderTransform>
                    </Border>
                </Canvas>
            </Border>

            <TextBlock Text="选中层参数" Style="{DynamicResource Text.SectionHeader}" Margin="0,24,0,10" />
            <Grid IsEnabled="{Binding HasSelected}" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                    <TextBlock Text="X" Style="{DynamicResource Text.Caption}" />
                    <TextBox Text="{Binding BoundsX, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                    <TextBlock Text="Y" Style="{DynamicResource Text.Caption}" />
                    <TextBox Text="{Binding BoundsY, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                    <TextBlock Text="宽度" Style="{DynamicResource Text.Caption}" />
                    <TextBox Text="{Binding BoundsWidth, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8">
                    <TextBlock Text="高度" Style="{DynamicResource Text.Caption}" />
                    <TextBox Text="{Binding BoundsHeight, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                    <TextBlock Text="透明度" Style="{DynamicResource Text.Caption}" />
                    <TextBox Text="{Binding Opacity, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,8">
                    <TextBlock Text="起始片段" Style="{DynamicResource Text.Caption}" />
                    <TextBox Text="{Binding StartClipIndex, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,4,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="尺寸" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Width="40" />
                        <Slider Grid.Column="1"
                                Minimum="0.01"
                                Maximum="4"
                                Value="{Binding Scale}"
                                TickFrequency="0.1"
                                IsSnapToTickEnabled="False"
                                Margin="8,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Scale, StringFormat={}{0:P0}}"
                                   Style="{DynamicResource Text.Mono}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,8">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="位置 X" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Width="40" />
                        <Slider Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding OffsetX}" Margin="8,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding OffsetX, StringFormat={}{0:0.##}}"
                                   Style="{DynamicResource Text.Mono}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="位置 Y" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Width="40" />
                        <Slider Grid.Column="1" Minimum="-1" Maximum="1" Value="{Binding OffsetY}" Margin="8,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding OffsetY, StringFormat={}{0:0.##}}"
                                   Style="{DynamicResource Text.Mono}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="5" Grid.ColumnSpan="2">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="旋转" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Width="40" />
                        <Slider Grid.Column="1" Minimum="-180" Maximum="180" Value="{Binding RotationDegrees}" Margin="8,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding RotationDegrees, StringFormat={}{0:0.#}°}"
                                   Style="{DynamicResource Text.Mono}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="羽化" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Width="40" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Feather}" Margin="8,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Feather, StringFormat={}{0:P0}}"
                                   Style="{DynamicResource Text.Mono}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Grid>

            <WrapPanel Margin="0,8,0,0">
                <CheckBox Content="混入蒙版音轨"
                          IsChecked="{Binding MixOverlayAudio}"
                          IsEnabled="{Binding HasSelected}"
                          Margin="0,0,16,8"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="混入蒙版音轨到成片" />
                <Button Style="{DynamicResource Button.Secondary}"
                        Content="应用参数"
                        Command="{Binding ApplyBoundsCommand}"
                        Margin="0,0,8,8"
                        AutomationProperties.Name="应用蒙版参数到选中层" />
                <Button Style="{DynamicResource Button.Secondary}"
                        Content="移除选中"
                        Command="{Binding RemoveSelectedCommand}"
                        AutomationProperties.Name="移除选中蒙版层" />
            </WrapPanel>

            <TextBlock Text="配置完成后，在混剪页开启「启用蒙版叠加到成片」（可选「随机套用素材库」）并入队，蒙版将渲染到最终成片。"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,16,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
