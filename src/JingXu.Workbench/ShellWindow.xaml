<Window x:Class="JingXu.Workbench.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:JingXu.Workbench.Features.Shell"
        xmlns:queue="clr-namespace:JingXu.Workbench.Features.Queue"
        xmlns:composition="clr-namespace:JingXu.Workbench.Features.Composition"
        xmlns:overlays="clr-namespace:JingXu.Workbench.Features.Overlays"
        xmlns:stickers="clr-namespace:JingXu.Workbench.Features.Stickers"
        xmlns:settings="clr-namespace:JingXu.Workbench.Features.Settings"
        xmlns:downloads="clr-namespace:JingXu.Workbench.Features.Downloads"
        mc:Ignorable="d"
        xmlns:audio="clr-namespace:JingXu.Workbench.Features.AudioLibrary"
        xmlns:spider="clr-namespace:JingXu.Workbench.Features.Spider"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        d:DataContext="{d:DesignInstance shell:ShellViewModel}"
         Title="炳恒快速混剪"
         Icon="Assets/AppIcon.ico"
        Width="1600"
        Height="920"
        MinWidth="1120"
        MinHeight="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{DynamicResource Font.Body}"
        Foreground="{DynamicResource Ink.Primary}"
        Background="{DynamicResource Surface.Canvas}"
        Loaded="OnLoaded"
        StateChanged="OnStateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type composition:CompositionViewModel}">
            <composition:CompositionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type overlays:OverlayEditorViewModel}">
            <overlays:OverlayEditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type stickers:StickerEditorViewModel}">
            <stickers:StickerEditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type queue:RenderQueueViewModel}">
            <queue:RenderQueueView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:SettingsViewModel}">
            <settings:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type downloads:DownloadViewModel}">
            <downloads:DownloadView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type audio:AudioLibraryViewModel}">
            <audio:AudioLibraryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type spider:SpiderViewModel}">
            <spider:SpiderView />
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="{DynamicResource Surface.Canvas}"
            BorderBrush="{DynamicResource Line.Strong}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="{Binding IsQueueExpanded, Converter={StaticResource BoolToGridLength}, ConverterParameter=144|36}" />
            </Grid.RowDefinitions>

            <!-- ═══ 标题栏 ═══════════════════════════════════════════════ -->
            <Border x:Name="TitleBarRegion"
                    Grid.Row="0"
                    Background="{DynamicResource Surface.Panel}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 铭牌：Logo + 软件名 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Image Source="Assets/AppLogo.png"
                               Width="28"
                               Height="28"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Border Width="1" Height="20" Background="{DynamicResource Line.Default}" Margin="12,0,12,0" />
                        <TextBlock Text="炳恒快速混剪" Style="{DynamicResource Text.Wordmark}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 项目名 + 保存状态 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProjectName}" Style="{DynamicResource Text.Body}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SaveStateText}" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>

                    <!-- 离线 + 窗口按钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Brand.Bloom}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding OfflineText}" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="MinimizeButton"
                                Style="{DynamicResource TitleBar.IconButton}"
                                Content="{DynamicResource Icon.Win.Minimize}"
                                Click="OnMinimize"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                AutomationProperties.Name="最小化窗口" />
                        <Button x:Name="MaximizeButton"
                                Style="{DynamicResource TitleBar.IconButton}"
                                Content="{DynamicResource Icon.Win.Maximize}"
                                Click="OnMaximizeRestore"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                AutomationProperties.Name="最大化窗口" />
                        <Button x:Name="CloseButton"
                                Style="{DynamicResource TitleBar.CloseButton}"
                                Content="{DynamicResource Icon.Win.Close}"
                                Click="OnClose"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                AutomationProperties.Name="关闭窗口" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ 主体：五区 ═══════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{Binding IsInspectorExpanded, Converter={StaticResource BoolToGridLength}, ConverterParameter=300|44}" />
                </Grid.ColumnDefinitions>

                <!-- 模块导航栏 -->
                <Border x:Name="ModuleRailRegion"
                        Grid.Column="0"
                        Background="{DynamicResource Surface.Rail}"
                        BorderBrush="{DynamicResource Line.Default}"
                        BorderThickness="0,0,1,0">
                    <ListBox Style="{DynamicResource ModuleRail}"
                             ItemContainerStyle="{DynamicResource ModuleRail.Item}"
                             ItemsSource="{Binding Modules}"
                             SelectedValuePath="ModuleKind"
                             SelectedValue="{Binding SelectedModule, Mode=TwoWay}"
                             VerticalAlignment="Top"
                             Margin="0,8,0,0"
                             AutomationProperties.Name="模块导航" />
                </Border>

                <!-- 素材栏 -->
                <Border x:Name="MaterialRailRegion"
                        Grid.Column="1"
                        Background="{DynamicResource Surface.Panel}"
                        BorderBrush="{DynamicResource Line.Default}"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                BorderBrush="{DynamicResource Line.Default}"
                                BorderThickness="0,0,0,1"
                                Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding MaterialTitle}" Style="{DynamicResource Text.Title}" />
                                <Border Grid.Column="1"
                                        Background="{DynamicResource Surface.Sunk}"
                                        CornerRadius="{DynamicResource Radius.Small}"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MaterialCount}" Style="{DynamicResource Text.Mono}" FontSize="11" />
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1"
                                    VerticalAlignment="Center"
                                    Margin="24,0"
                                    Visibility="{Binding HasMaterials, Converter={StaticResource InverseBoolToVis}}">
                            <Path Data="{DynamicResource Icon.Module.Composition}"
                                  Stroke="{DynamicResource Line.Strong}"
                                  StrokeThickness="1.4"
                                  Width="30"
                                  Height="30"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center" />
                            <TextBlock Text="暂无素材"
                                       Style="{DynamicResource Text.Body}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,4" />
                            <TextBlock Text="{Binding MaterialEmptyHint}"
                                       Style="{DynamicResource Text.Caption}"
                                       TextAlignment="Center" />
                        </StackPanel>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding CompositionModule.Materials}"
                                 SelectedItem="{Binding CompositionModule.SelectedMaterial, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="8,6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding HasMaterials, Converter={StaticResource BoolToVis}}"
                                 AutomationProperties.Name="素材列表">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="RowBorder"
                                                        Background="{DynamicResource Surface.PanelMuted}"
                                                        BorderBrush="{DynamicResource Line.Default}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource Radius.Small}"
                                                        Padding="10,8">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource Brand.Bloom}" />
                                                        <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Surface.Sunk}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type composition:MaterialRowViewModel}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding FileName}" Style="{DynamicResource Text.Body}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,4,0,0">
                                            <Run Text="{Binding SequenceLabel, Mode=OneWay}" FontFamily="{DynamicResource Font.Mono}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding DurationText, Mode=OneWay}" FontFamily="{DynamicResource Font.Mono}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding ResolutionText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- 中央工作区：取景井 + 模块内容 -->
                <Grid x:Name="CenterRegion" Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.3*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 取景井（唯一深色区域，1px 增透膜冷光井口边）-->
                    <Border x:Name="GateWell"
                            Grid.Row="0"
                            Margin="16"
                            Background="{DynamicResource Gate.Well}"
                            BorderBrush="{DynamicResource Brand.Bloom}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Standard}"
                            Visibility="{Binding IsCompositionModule, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <TextBlock Text="取景井"
                                       Style="{DynamicResource Text.Gate.Caption}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Margin="14,12,0,0" />
                            <shell:GateMonitorView DataContext="{Binding Monitor}" Margin="0,28,0,0" />
                        </Grid>
                    </Border>

                    <!-- 模块内容（导航切换时淡入）-->
                    <ContentControl x:Name="ModuleContentHost"
                                    Content="{Binding CurrentModule}"
                                    Focusable="False"
                                    ClipToBounds="True"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.RowSpan" Value="2" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompositionModule}" Value="True">
                                        <Setter Property="Grid.Row" Value="1" />
                                        <Setter Property="Grid.RowSpan" Value="1" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>

                <!-- 检查器（可折叠）-->
                <Border x:Name="InspectorRegion"
                        Grid.Column="3"
                        Background="{DynamicResource Surface.Panel}"
                        BorderBrush="{DynamicResource Line.Default}"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <!-- 展开态 -->
                        <Grid Visibility="{Binding IsInspectorExpanded, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    BorderBrush="{DynamicResource Line.Default}"
                                    BorderThickness="0,0,0,1"
                                    Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding InspectorTitle}" Style="{DynamicResource Text.Title}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Style="{DynamicResource TitleBar.IconButton}"
                                            Width="28"
                                            Height="28"
                                            Content="{DynamicResource Icon.Ui.Collapse}"
                                            Command="{Binding ToggleInspectorCommand}"
                                            AutomationProperties.Name="折叠检查器" />
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,4,16,4">
                                <StackPanel>
                                    <Expander Style="{DynamicResource Section}" Header="工作区">
                                        <StackPanel>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="项目" Style="{DynamicResource Text.Caption}" Width="56" />
                                                <TextBlock Grid.Column="1" Text="{Binding ProjectName}" Style="{DynamicResource Text.Body}" />
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="保存" Style="{DynamicResource Text.Caption}" Width="56" />
                                                <TextBlock Grid.Column="1" Text="{Binding SaveStateText}" Style="{DynamicResource Text.Body}" />
                                            </Grid>
                                        </StackPanel>
                                    </Expander>

                                    <Expander Style="{DynamicResource Section}" Header="输出">
                                        <TextBlock Text="{Binding OutputRuleText}" Style="{DynamicResource Text.Caption}" />
                                    </Expander>

                                    <Expander Style="{DynamicResource Section}" Header="数据目录">
                                        <TextBlock Text="{Binding DataDirectory}" Style="{DynamicResource Text.Mono}" FontSize="11" TextWrapping="Wrap" />
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 底部唯一实心绿主操作 -->
                            <Border Grid.Row="2" Padding="16" BorderBrush="{DynamicResource Line.Default}" BorderThickness="0,1,0,0">
                                <Button Style="{DynamicResource Button.Primary}"
                                        Content="打开数据目录"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding OpenDataDirectoryCommand}"
                                        AutomationProperties.Name="打开本地数据目录" />
                            </Border>
                        </Grid>

                        <!-- 折叠态：窄条 + 展开按钮 -->
                        <StackPanel Visibility="{Binding IsInspectorExpanded, Converter={StaticResource InverseBoolToVis}}"
                                    HorizontalAlignment="Center"
                                    Margin="0,12,0,0">
                            <Button Style="{DynamicResource TitleBar.IconButton}"
                                    Width="30"
                                    Height="30"
                                    Content="{DynamicResource Icon.Ui.ExpandLeft}"
                                    Command="{Binding ToggleInspectorCommand}"
                                    AutomationProperties.Name="展开检查器" />
                            <TextBlock Text="属性"
                                       Style="{DynamicResource Text.Caption}"
                                       Margin="0,10,0,0"
                                       HorizontalAlignment="Center">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="90" />
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ 底部持久队列条（可折叠）══════════════════════════════ -->
            <Border x:Name="QueueRegion"
                    Grid.Row="2"
                    Background="{DynamicResource Surface.Panel}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="任务队列" Style="{DynamicResource Text.SectionHeader}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding QueueModule.SummaryText}"
                                   Style="{DynamicResource Text.Caption}"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0" />
                        <Button Grid.Column="3"
                                Style="{DynamicResource TitleBar.IconButton}"
                                Width="30"
                                Height="30"
                                Content="{DynamicResource Icon.Ui.Chevron}"
                                Command="{Binding ToggleQueueCommand}"
                                AutomationProperties.Name="折叠或展开队列" />
                    </Grid>

                    <Border Grid.Row="1"
                            Visibility="{Binding IsQueueExpanded, Converter={StaticResource BoolToVis}}"
                            Margin="16,4,16,12"
                            Background="{DynamicResource Surface.PanelMuted}"
                            BorderBrush="{DynamicResource Line.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Standard}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                            <Path Data="{DynamicResource Icon.Status.Draft}"
                                  Stroke="{DynamicResource Ink.Muted}"
                                  StrokeThickness="2"
                                  Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center" />
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding QueueModule.SummaryText}"
                                           Style="{DynamicResource Text.Body}" />
                                <ProgressBar Height="5"
                                             Width="220"
                                             Margin="0,6,0,0"
                                             HorizontalAlignment="Left"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding QueueModule.OverallProgressPercent, Mode=OneWay}"
                                             Visibility="{Binding QueueModule.HasOverallProgress, Converter={StaticResource BoolToVis}}"
                                             AutomationProperties.Name="底部队列整体进度" />
                            </StackPanel>
                            <TextBlock Text="· 完成编排后加入队列，可在此跟踪阶段、进度并取消或重试。"
                                       Style="{DynamicResource Text.Caption}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
