<UserControl x:Class="JingXu.Workbench.Features.Composition.CompositionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:composition="clr-namespace:JingXu.Workbench.Features.Composition"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance composition:CompositionViewModel}"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" Style="{DynamicResource Text.Title}" />
                    <TextBlock Text="{Binding PreviewSummary}"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,6,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{DynamicResource Button.Secondary}"
                            Content="清理素材"
                            Command="{Binding ClearMaterialsCommand}"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="清理当前商品组素材" />
                    <Button Style="{DynamicResource Button.Secondary}"
                            Content="导入素材"
                            Command="{Binding PickImportFilesCommand}"
                            IsEnabled="{Binding CanPickImportFiles}"
                            AutomationProperties.Name="导入视频素材" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding StatusMessage}"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,8,0,0"
                       Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}" />

            <TextBlock Text="商品工作组" Style="{DynamicResource Text.SectionHeader}" Margin="0,18,0,8" />
            <Border Style="{DynamicResource Segmented.Container}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{DynamicResource Segmented.Item}"
                                 GroupName="productWorkspace"
                                 Content="商品组 A"
                                 IsChecked="{Binding IsWorkspaceA, Mode=OneWay}"
                                 Command="{Binding SwitchWorkspaceCommand}"
                                 CommandParameter="0"
                                 AutomationProperties.Name="切换到商品组 A" />
                    <RadioButton Style="{DynamicResource Segmented.Item}"
                                 GroupName="productWorkspace"
                                 Content="商品组 B"
                                 IsChecked="{Binding IsWorkspaceB, Mode=OneWay}"
                                 Command="{Binding SwitchWorkspaceCommand}"
                                 CommandParameter="1"
                                 AutomationProperties.Name="切换到商品组 B" />
                </StackPanel>
            </Border>
            <TextBlock Text="两组可分别导入不同商品素材并各自「加入队列」；开启并发后可同时渲染。"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />

            <TextBlock Text="素材" Style="{DynamicResource Text.SectionHeader}" Margin="0,18,0,8" />
            <TextBlock Text="同一商品组内重复导入会追加素材并可能打乱序号；做下一商品前请先「清理素材」，或切换到另一商品组。"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap" />
            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="12,8"
                    Visibility="{Binding HasMaterials, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Materials}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type composition:MaterialRowViewModel}">
                            <Border BorderBrush="{DynamicResource Line.Default}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,8"
                                    Cursor="Hand"
                                    Background="Transparent">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.SelectMaterialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Surface.Sunk}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding SequenceLabel}"
                                               Style="{DynamicResource Text.Mono}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                        <TextBlock Text="{Binding FileName}" Style="{DynamicResource Text.Body}" />
                                        <TextBlock Text="{Binding Diagnostic}"
                                                   Style="{DynamicResource Text.Caption}"
                                                   Foreground="{DynamicResource Status.Running.Text}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasDiagnostic, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding DurationText}"
                                               Style="{DynamicResource Text.Mono}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding ResolutionText}"
                                               Style="{DynamicResource Text.Caption}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="16,20"
                    Visibility="{Binding HasMaterials, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="暂无素材。点击「导入素材」选择视频文件，系统将自动探测时长、分辨率并解析文件名序号。"
                           Style="{DynamicResource Text.Caption}"
                           TextAlignment="Center" />
            </Border>

            <TextBlock Text="编排" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <Border Style="{DynamicResource Segmented.Container}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{DynamicResource Segmented.Item}"
                                 GroupName="compositionMode"
                                 Content="随机批量"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=Random}" />
                    <RadioButton Style="{DynamicResource Segmented.Item}"
                                 GroupName="compositionMode"
                                 Content="自定义序号"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumToBool}, ConverterParameter=CustomSequence}" />
                </StackPanel>
            </Border>
            <Grid Margin="0,12,0,0"
                  Visibility="{Binding IsRandomMode, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="批量数量" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding BatchCount, UpdateSourceTrigger=PropertyChanged}"
                         Margin="10,0,0,0"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="随机批量数量" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="随机种子" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="4"
                         Text="{Binding RandomSeed, UpdateSourceTrigger=PropertyChanged}"
                         Margin="10,0,0,0"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="随机种子" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="每片素材数" Style="{DynamicResource Text.Caption}"
                           VerticalAlignment="Center" Margin="0,10,0,0" />
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding ClipsPerPlan, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                         Margin="10,10,0,0"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="每片素材数" />
                <TextBlock Grid.Row="1" Grid.Column="3"
                           Grid.ColumnSpan="2"
                           Text="留空=使用全部素材"
                           Style="{DynamicResource Text.Caption}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Text.Secondary}"
                           Margin="10,10,0,0" />
            </Grid>
            <TextBlock Text="{Binding ClipsPerPlanHint}"
                       Style="{DynamicResource Text.Caption}"
                       Foreground="{DynamicResource Text.Secondary}"
                       Margin="0,4,0,0"
                       Visibility="{Binding IsRandomMode, Converter={StaticResource BoolToVis}}" />

            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding IsCustomMode, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="序号表达式（一条成片的片段顺序）" Style="{DynamicResource Text.Caption}" />
                <TextBox Text="{Binding SequenceExpression, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,6,0,0"
                         Padding="10,8"
                         MinHeight="72"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="自定义序号表达式" />
                <Border Background="{DynamicResource Surface.PanelMuted}"
                        BorderBrush="{DynamicResource Line.Default}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Standard}"
                        Padding="12,10"
                        Margin="0,10,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="命名模板"
                                       Style="{DynamicResource Text.Caption}"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding SequenceTemplatesList}"
                                      SelectedItem="{Binding SelectedSequenceTemplate}"
                                      DisplayMemberPath="DisplayName"
                                      Margin="10,0,8,0"
                                      Padding="8,6"
                                      AutomationProperties.Name="序号模板列表" />
                            <Button Grid.Column="2"
                                    Style="{DynamicResource Button.Secondary}"
                                    Content="刷新"
                                    Command="{Binding LoadSequenceTemplatesCommand}"
                                    Margin="0,0,8,0"
                                    AutomationProperties.Name="刷新序号模板" />
                            <Button Grid.Column="3"
                                    Style="{DynamicResource Button.Secondary}"
                                    Content="应用"
                                    Command="{Binding ApplySelectedSequenceTemplateCommand}"
                                    AutomationProperties.Name="应用选中序号模板" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="模板名称"
                                       Style="{DynamicResource Text.Caption}"
                                       VerticalAlignment="Center" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding SequenceTemplateName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="10,0,8,0"
                                     Padding="8,6"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="序号模板名称" />
                            <Button Grid.Column="2"
                                    Style="{DynamicResource Button.Secondary}"
                                    Content="保存当前"
                                    Command="{Binding SaveCurrentSequenceTemplateCommand}"
                                    Margin="0,0,8,0"
                                    AutomationProperties.Name="保存当前序号为命名模板" />
                            <Button Grid.Column="3"
                                    Style="{DynamicResource Button.Secondary}"
                                    Content="重命名"
                                    Command="{Binding RenameSelectedSequenceTemplateCommand}"
                                    Margin="0,0,8,0"
                                    AutomationProperties.Name="重命名选中序号模板" />
                            <Button Grid.Column="4"
                                    Style="{DynamicResource Button.Secondary}"
                                    Content="删除"
                                    Command="{Binding DeleteSelectedSequenceTemplateCommand}"
                                    AutomationProperties.Name="删除选中序号模板" />
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Style="{DynamicResource Text.Caption}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap">
                    <Run Text="单任务：" />
                    <Run Text="264513" FontFamily="{DynamicResource Font.Mono}" />
                    <Run Text=" 或 " />
                    <Run Text="2,6,14,5,1,3" FontFamily="{DynamicResource Font.Mono}" />
                    <LineBreak />
                    <Run Text="多任务：每行一串，或用分号分隔，如 " />
                    <Run Text="264513; 351246" FontFamily="{DynamicResource Font.Mono}" />
                    <Run Text="。每条表达式生成一条独立入队任务。" />
                </TextBlock>
            </StackPanel>

            <TextBlock Text="编排预览" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <ItemsControl ItemsSource="{Binding PreviewPlans}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type composition:PreviewPlanRowViewModel}">
                        <Border Background="{DynamicResource Surface.PanelMuted}"
                                BorderBrush="{DynamicResource Line.Default}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Standard}"
                                Padding="14,12"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding DurationText}" Style="{DynamicResource Text.Mono}" />
                                </Grid>
                                <TextBlock Text="{Binding SequenceText}"
                                           Style="{DynamicResource Text.Mono}"
                                           FontSize="11.5"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding ValidationMessage}"
                       Style="{DynamicResource Text.Caption}"
                       Foreground="{DynamicResource Status.Running.Text}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVis}}" />

            <TextBlock Text="输出" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="输出目录" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                         Margin="10,0,8,0"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="成片输出目录" />
                <Button Grid.Column="2"
                        Style="{DynamicResource Button.Secondary}"
                        Content="浏览…"
                        Command="{Binding PickOutputDirectoryCommand}"
                        AutomationProperties.Name="选择成片输出目录" />
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="文件名前缀" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding OutputFileNamePrefix, UpdateSourceTrigger=PropertyChanged}"
                         Margin="10,0,0,0"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="成片文件名前缀" />
            </Grid>
            <TextBlock Text="单条成片使用「前缀.mp4」；批量时自动追加 _001、_002 等序号。导入后默认输出到源目录「分镜输出」（多来源则用项目目录）。"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />

            <TextBlock Text="输出质量" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <Border Style="{DynamicResource Segmented.Container}" HorizontalAlignment="Left">
                <WrapPanel>
                    <RadioButton Style="{DynamicResource Segmented.Item}"
                                 GroupName="qualityPreset"
                                 Content="无损直拷"
                                 IsChecked="{Binding SelectedQuality, Converter={StaticResource EnumToBool}, ConverterParameter=Lossless}"
                                 AutomationProperties.Name="输出质量无损直拷" />
                    <RadioButton Style="{DynamicResource Segmented.Item}"
                                 GroupName="qualityPreset"
                                 Content="高质量"
                                 IsChecked="{Binding SelectedQuality, Converter={StaticResource EnumToBool}, ConverterParameter=High}"
                                 AutomationProperties.Name="输出质量高质量" />
                    <RadioButton Style="{DynamicResource Segmented.Item}"
                                 GroupName="qualityPreset"
                                 Content="平衡"
                                 IsChecked="{Binding SelectedQuality, Converter={StaticResource EnumToBool}, ConverterParameter=Balanced}"
                                 AutomationProperties.Name="输出质量平衡" />
                    <RadioButton Style="{DynamicResource Segmented.Item}"
                                 GroupName="qualityPreset"
                                 Content="小体积"
                                 IsChecked="{Binding SelectedQuality, Converter={StaticResource EnumToBool}, ConverterParameter=Small}"
                                 AutomationProperties.Name="输出质量小体积" />
                    <RadioButton Style="{DynamicResource Segmented.Item}"
                                 GroupName="qualityPreset"
                                 Content="快速"
                                 IsChecked="{Binding SelectedQuality, Converter={StaticResource EnumToBool}, ConverterParameter=Fast}"
                                 AutomationProperties.Name="输出质量快速预览" />
                </WrapPanel>
            </Border>
            <TextBlock Text="{Binding QualityHint}"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap" />

            <TextBlock Text="处理器" Style="{DynamicResource Text.SectionHeader}" Margin="0,14,0,8" />
            <Border Style="{DynamicResource Segmented.Container}" HorizontalAlignment="Left">
                <WrapPanel>
                    <RadioButton Style="{DynamicResource Segmented.Item}"
                                 GroupName="processingMode"
                                 Content="自动（推荐）"
                                 IsChecked="{Binding SelectedProcessingMode, Converter={StaticResource EnumToBool}, ConverterParameter=Auto}"
                                 AutomationProperties.Name="处理器自动" />
                    <RadioButton Style="{DynamicResource Segmented.Item}"
                                 GroupName="processingMode"
                                 Content="CPU（兼容稳定）"
                                 IsChecked="{Binding SelectedProcessingMode, Converter={StaticResource EnumToBool}, ConverterParameter=Cpu}"
                                 AutomationProperties.Name="处理器CPU" />
                    <RadioButton Style="{DynamicResource Segmented.Item}"
                                 GroupName="processingMode"
                                 Content="GPU（硬件加速）"
                                 IsChecked="{Binding SelectedProcessingMode, Converter={StaticResource EnumToBool}, ConverterParameter=Gpu}"
                                 AutomationProperties.Name="处理器GPU" />
                </WrapPanel>
            </Border>

            <TextBlock Text="导出兼容性" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="14,12">
                <StackPanel>
                    <TextBlock Text="输出分辨率"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,0,0,6" />
                    <Border Style="{DynamicResource Segmented.Container}"
                            HorizontalAlignment="Left">
                        <WrapPanel>
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="outputResolution"
                                         Content="原画（保持当前画幅）"
                                         IsChecked="{Binding SelectedOutputResolution, Converter={StaticResource EnumToBool}, ConverterParameter=Original}"
                                         AutomationProperties.Name="导出分辨率原画" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="outputResolution"
                                         Content="1080P"
                                         IsChecked="{Binding SelectedOutputResolution, Converter={StaticResource EnumToBool}, ConverterParameter=P1080}"
                                         AutomationProperties.Name="导出分辨率1080P" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="outputResolution"
                                         Content="720P"
                                         IsChecked="{Binding SelectedOutputResolution, Converter={StaticResource EnumToBool}, ConverterParameter=P720}"
                                         AutomationProperties.Name="导出分辨率720P" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="outputResolution"
                                         Content="480P"
                                         IsChecked="{Binding SelectedOutputResolution, Converter={StaticResource EnumToBool}, ConverterParameter=P480}"
                                         AutomationProperties.Name="导出分辨率480P" />
                        </WrapPanel>
                    </Border>
                    <TextBlock Text="输出帧率"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,12,0,6" />
                    <Border Style="{DynamicResource Segmented.Container}"
                            HorizontalAlignment="Left">
                        <WrapPanel>
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="outputFrameRate"
                                         Content="原帧率（跟随首段）"
                                         IsChecked="{Binding SelectedOutputFrameRate, Converter={StaticResource EnumToBool}, ConverterParameter=Original}"
                                         AutomationProperties.Name="导出帧率原帧率" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="outputFrameRate"
                                         Content="24 fps"
                                         IsChecked="{Binding SelectedOutputFrameRate, Converter={StaticResource EnumToBool}, ConverterParameter=Fps24}"
                                         AutomationProperties.Name="导出帧率24fps" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="outputFrameRate"
                                         Content="25 fps"
                                         IsChecked="{Binding SelectedOutputFrameRate, Converter={StaticResource EnumToBool}, ConverterParameter=Fps25}"
                                         AutomationProperties.Name="导出帧率25fps" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="outputFrameRate"
                                         Content="30 fps（手机兼容）"
                                         IsChecked="{Binding SelectedOutputFrameRate, Converter={StaticResource EnumToBool}, ConverterParameter=Fps30}"
                                         AutomationProperties.Name="导出帧率30fps手机兼容" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="outputFrameRate"
                                         Content="50 fps"
                                         IsChecked="{Binding SelectedOutputFrameRate, Converter={StaticResource EnumToBool}, ConverterParameter=Fps50}"
                                         AutomationProperties.Name="导出帧率50fps" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="outputFrameRate"
                                         Content="60 fps"
                                         IsChecked="{Binding SelectedOutputFrameRate, Converter={StaticResource EnumToBool}, ConverterParameter=Fps60}"
                                         AutomationProperties.Name="导出帧率60fps" />
                        </WrapPanel>
                    </Border>
                    <TextBlock Text="原画与原帧率默认保持现有输出；选择分辨率或固定帧率会强制重新编码。手机导入失败时，优先尝试 720P + 30 fps。"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="统一比例" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="14,12">
                <StackPanel>
                    <CheckBox Content="启用统一比例（片段与蒙版对齐到同一画幅后再叠加）"
                              IsChecked="{Binding EnableUnifiedAspect}"
                              AutomationProperties.Name="启用统一比例" />
                    <TextBlock Text="目标画幅"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,10,0,6"
                               IsEnabled="{Binding EnableUnifiedAspect}" />
                    <Border Style="{DynamicResource Segmented.Container}"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding EnableUnifiedAspect}">
                        <WrapPanel>
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="aspectPreset"
                                         Content="9:16 竖屏"
                                         IsChecked="{Binding AspectPreset, Converter={StaticResource EnumToBool}, ConverterParameter=Vertical9x16}" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="aspectPreset"
                                         Content="16:9 横屏"
                                         IsChecked="{Binding AspectPreset, Converter={StaticResource EnumToBool}, ConverterParameter=Horizontal16x9}" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="aspectPreset"
                                         Content="1:1 方形"
                                         IsChecked="{Binding AspectPreset, Converter={StaticResource EnumToBool}, ConverterParameter=Square1x1}" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="aspectPreset"
                                         Content="3:4 竖屏"
                                         IsChecked="{Binding AspectPreset, Converter={StaticResource EnumToBool}, ConverterParameter=Portrait3x4}" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="aspectPreset"
                                         Content="继承首段"
                                         IsChecked="{Binding AspectPreset, Converter={StaticResource EnumToBool}, ConverterParameter=InheritFirst}" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="aspectPreset"
                                         Content="自定义"
                                         IsChecked="{Binding AspectPreset, Converter={StaticResource EnumToBool}, ConverterParameter=Custom}" />
                        </WrapPanel>
                    </Border>
                    <Grid Margin="0,10,0,0"
                          Visibility="{Binding IsCustomAspectPreset, Converter={StaticResource BoolToVis}}"
                          IsEnabled="{Binding EnableUnifiedAspect}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="72" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="自定义" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding CustomAspectWidth, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="×" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <TextBox Grid.Column="3"
                                 Text="{Binding CustomAspectHeight, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 VerticalContentAlignment="Center" />
                    </Grid>
                    <TextBlock Text="拼接素材适配"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,12,0,6"
                               IsEnabled="{Binding EnableUnifiedAspect}" />
                    <Border Style="{DynamicResource Segmented.Container}"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding EnableUnifiedAspect}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="clipFitMode"
                                         Content="居中裁切"
                                         IsChecked="{Binding ClipFitMode, Converter={StaticResource EnumToBool}, ConverterParameter=CenterCrop}" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="clipFitMode"
                                         Content="黑边"
                                         IsChecked="{Binding ClipFitMode, Converter={StaticResource EnumToBool}, ConverterParameter=Letterbox}" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="clipFitMode"
                                         Content="拉伸"
                                         IsChecked="{Binding ClipFitMode, Converter={StaticResource EnumToBool}, ConverterParameter=Stretch}" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="clipFitMode"
                                         Content="模糊背景"
                                         IsChecked="{Binding ClipFitMode, Converter={StaticResource EnumToBool}, ConverterParameter=BlurBackground}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="蒙版素材适配"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,12,0,6"
                               IsEnabled="{Binding EnableUnifiedAspect}" />
                    <Border Style="{DynamicResource Segmented.Container}"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding EnableUnifiedAspect}">
                        <WrapPanel>
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="overlayFitMode"
                                         Content="填满裁切"
                                         IsChecked="{Binding OverlayFitMode, Converter={StaticResource EnumToBool}, ConverterParameter=FillCrop}" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="overlayFitMode"
                                         Content="裁成画幅再覆盖"
                                         IsChecked="{Binding OverlayFitMode, Converter={StaticResource EnumToBool}, ConverterParameter=MatchCanvasCrop}" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="overlayFitMode"
                                         Content="完整适配"
                                         IsChecked="{Binding OverlayFitMode, Converter={StaticResource EnumToBool}, ConverterParameter=Contain}" />
                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                         GroupName="overlayFitMode"
                                         Content="拉伸"
                                         IsChecked="{Binding OverlayFitMode, Converter={StaticResource EnumToBool}, ConverterParameter=Stretch}" />
                        </WrapPanel>
                    </Border>
                    <TextBlock Text="商品 3:4 + 蒙版 9:16 时请用「裁成画幅再覆盖」（选 3:4 画幅会自动切到此项）；可在蒙版页调选取偏移、分割位置与羽化。"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               IsEnabled="{Binding EnableUnifiedAspect}" />
                    <TextBlock Text="{Binding UnifiedAspectPreviewDescription}"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="蒙版覆盖" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="14,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  Content="启用蒙版覆盖到成片"
                                  IsChecked="{Binding EnableOverlayOnOutput}"
                                  AutomationProperties.Name="启用蒙版覆盖到成片" />
                        <Border Grid.Column="1"
                                Background="{DynamicResource Surface.Sunk}"
                                BorderBrush="{DynamicResource Line.Default}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Small}"
                                Padding="8,4"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding OverlayStatusLabel}"
                                       Style="{DynamicResource Text.Caption}"
                                       FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <CheckBox Content="每条成片随机替换 1 个素材库蒙版"
                              IsChecked="{Binding UseRandomOverlayLibrary}"
                              IsEnabled="{Binding IsOverlaySectionEnabled}"
                              Margin="0,10,0,0"
                              AutomationProperties.Name="随机替换素材库蒙版" />
                    <TextBlock Text="效果预览"
                               Style="{DynamicResource Text.Caption}"
                               FontWeight="SemiBold"
                               Margin="0,12,0,4"
                               Visibility="{Binding HasOverlayEffectPreview, Converter={StaticResource BoolToVis}}" />
                    <Border Width="216"
                            Height="384"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Surface.Sunk}"
                            BorderBrush="{DynamicResource Line.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Small}"
                            ClipToBounds="True"
                            Margin="0,0,0,8"
                            Visibility="{Binding HasOverlayEffectPreview, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <TextBlock Text="生成中或暂无预览"
                                       Style="{DynamicResource Text.Caption}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="12"
                                       Visibility="{Binding HasOverlayCompositePreview, Converter={StaticResource InverseBoolToVis}}" />
                            <Image Source="{Binding OverlayCompositePreviewPath, Converter={StaticResource PathToBitmap}, ConverterParameter=432}"
                                   Stretch="Uniform"
                                   Visibility="{Binding HasOverlayCompositePreview, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding OverlayCompositePreviewHint}"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,0,0,6"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasOverlayEffectPreview, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding OverlayEffectPreviewText}"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,0,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasOverlayEffectPreview, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="蒙版在渲染阶段覆盖到成片；随机替换模式下每条成片只使用 1 个蒙版，不会把库内蒙版继续堆叠。"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="效果模板" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="14,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="命名模板" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding EffectTemplatesList}"
                                  SelectedItem="{Binding SelectedEffectTemplate}"
                                  DisplayMemberPath="DisplayName"
                                  Margin="10,0,8,0"
                                  Padding="8,6"
                                  AutomationProperties.Name="效果模板列表" />
                        <Button Grid.Column="2"
                                Style="{DynamicResource Button.Secondary}"
                                Content="应用"
                                Command="{Binding ApplySelectedTemplateCommand}"
                                AutomationProperties.Name="应用选中效果模板" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="另存为" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding NewTemplateName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="10,0,8,0"
                                 Padding="8,6"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.Name="新效果模板名称" />
                        <Button Grid.Column="2"
                                Style="{DynamicResource Button.Secondary}"
                                Content="保存模板"
                                Command="{Binding SaveEffectTemplateCommand}"
                                AutomationProperties.Name="保存当前效果为命名模板" />
                    </Grid>
                    <Grid Margin="0,10,0,0"
                          IsEnabled="{Binding CanManageSelectedEffectTemplate}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="重命名为" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding EffectTemplateRenameName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="10,0,8,0"
                                 Padding="8,6"
                                 VerticalContentAlignment="Center"
                                 AutomationProperties.Name="效果模板重命名" />
                        <Button Grid.Column="2"
                                Style="{DynamicResource Button.Secondary}"
                                Content="重命名"
                                Command="{Binding RenameSelectedEffectTemplateCommand}"
                                Margin="0,0,8,0"
                                AutomationProperties.Name="重命名选中效果模板" />
                        <Button Grid.Column="3"
                                Style="{DynamicResource Button.Secondary}"
                                Content="删除"
                                Command="{Binding DeleteSelectedEffectTemplateCommand}"
                                AutomationProperties.Name="删除选中效果模板" />
                    </Grid>
                    <TextBlock Text="模板保存当前滤镜开关、强度与全部贴纸轨道参数；选择模板后可继续微调再入队。"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="效果与音频" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <CheckBox Content="启用差异化滤镜"
                      IsChecked="{Binding EnableVariationEffects}"
                      Margin="0,0,0,10"
                      AutomationProperties.Name="启用标准差异化滤镜" />
            <WrapPanel Margin="0,0,0,10" IsEnabled="{Binding IsVariationItemSwitchesEnabled}">
                <CheckBox Content="镜像"
                          IsChecked="{Binding VariationEnableMirror}"
                          Margin="0,0,14,6"
                          AutomationProperties.Name="差异化镜像开关" />
                <CheckBox Content="旋转"
                          IsChecked="{Binding VariationEnableRotate}"
                          Margin="0,0,14,6"
                          AutomationProperties.Name="差异化旋转开关" />
                <CheckBox Content="轻裁切"
                          IsChecked="{Binding VariationEnableCrop}"
                          Margin="0,0,14,6"
                          AutomationProperties.Name="差异化轻裁切开关" />
                <CheckBox Content="调色"
                          IsChecked="{Binding VariationEnableColor}"
                          Margin="0,0,14,6"
                          AutomationProperties.Name="差异化调色开关" />
                <CheckBox Content="降噪"
                          IsChecked="{Binding VariationEnableDenoise}"
                          Margin="0,0,14,6"
                          AutomationProperties.Name="差异化降噪开关" />
                <CheckBox Content="双屏"
                          IsChecked="{Binding EnableDoubleScreen}"
                          Margin="0,0,8,6"
                          AutomationProperties.Name="双屏特效开关" />
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,14,6"
                            IsEnabled="{Binding IsDoubleScreenStartEnabled}">
                    <TextBlock Text="从第"
                               Style="{DynamicResource Text.Caption}"
                               VerticalAlignment="Center" />
                    <TextBox Text="{Binding DoubleScreenStartClipIndex, UpdateSourceTrigger=PropertyChanged}"
                             Width="40"
                             Margin="5,0"
                             Padding="6,2"
                             AutomationProperties.Name="双屏起始视频序号" />
                    <TextBlock Text="个视频开始至结尾"
                               Style="{DynamicResource Text.Caption}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </WrapPanel>
            <WrapPanel Margin="0,0,0,10"
                       IsEnabled="{Binding IsDoubleScreenSettingsEnabled}">
                <CheckBox Content="随机抽取当前素材文件夹"
                          IsChecked="{Binding DoubleScreenUseRandomCurrentFolder}"
                          Margin="0,0,14,6"
                          AutomationProperties.Name="随机抽取当前素材文件夹素材" />
                <TextBlock Text="随机覆盖上方或下方"
                           Style="{DynamicResource Text.Caption}"
                           VerticalAlignment="Center"
                           Margin="0,0,14,6"
                           Visibility="{Binding IsDoubleScreenRandomSettingsEnabled, Converter={StaticResource BoolToVis}}" />
                <CheckBox Content="双屏中缝羽化"
                          IsChecked="{Binding DoubleScreenFeatherEnabled}"
                          Margin="0,0,14,6"
                          AutomationProperties.Name="双屏中缝羽化开关" />
                <TextBlock Text="双屏羽化强度"
                           Style="{DynamicResource Text.Caption}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,6" />
                <Slider Minimum="0"
                        Maximum="256"
                        TickFrequency="8"
                        IsSnapToTickEnabled="True"
                        Value="{Binding DoubleScreenFeatherPixels}"
                        Width="120"
                        Margin="0,0,8,6"
                        IsEnabled="{Binding DoubleScreenFeatherEnabled}"
                        AutomationProperties.Name="双屏羽化强度" />
                <TextBlock Text="{Binding DoubleScreenFeatherLabel}"
                           Style="{DynamicResource Text.Mono}"
                           VerticalAlignment="Center"
                           Margin="0,0,0,6" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,6" IsEnabled="{Binding EnableVariationEffects}">
                <CheckBox Content="四屏（2×2）"
                          IsChecked="{Binding EnableFourScreen}"
                          Margin="0,0,10,6"
                          AutomationProperties.Name="四屏特效开关" />
                <StackPanel Orientation="Horizontal" Margin="0,0,14,6"
                            IsEnabled="{Binding IsFourScreenSettingsEnabled}">
                    <TextBlock Text="从第" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                    <TextBox Text="{Binding FourScreenStartClipIndex, UpdateSourceTrigger=PropertyChanged}"
                             Width="40" Margin="5,0" Padding="6,2"
                             AutomationProperties.Name="四屏起始视频序号" />
                    <TextBlock Text="个视频开始至结尾" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="双屏与四屏只能选一项"
                           Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,0,6" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,4" IsEnabled="{Binding IsFourScreenSettingsEnabled}">
                <CheckBox Content="随机抽取主素材所在文件夹"
                          IsChecked="{Binding FourScreenUseRandomCurrentFolder}" Margin="0,0,14,6"
                          AutomationProperties.Name="四屏随机素材开关" />
                <CheckBox Content="四屏横竖缝羽化"
                          IsChecked="{Binding FourScreenFeatherEnabled}" Margin="0,0,14,6"
                          AutomationProperties.Name="四屏羽化开关" />
                <TextBlock Text="羽化强度" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,6,6" />
                <Slider Minimum="0" Maximum="256" TickFrequency="8" IsSnapToTickEnabled="True"
                        Value="{Binding FourScreenFeatherPixels}" Width="120" Margin="0,0,8,6"
                        IsEnabled="{Binding FourScreenFeatherEnabled}" AutomationProperties.Name="四屏羽化强度" />
                <TextBlock Text="{Binding FourScreenFeatherLabel}" Style="{DynamicResource Text.Mono}"
                           VerticalAlignment="Center" Margin="0,0,0,6" />
            </WrapPanel>
            <TextBlock Text="普通四屏同源同步；随机四屏保留一个主格，其余三格随机抽取，素材不足时允许重复。仅保留主素材声音和背景音乐。"
                       Style="{DynamicResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,10" />
            <Grid Margin="0,0,0,12" IsEnabled="{Binding IsVariationIntensityEnabled}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="差异化强度"
                           Style="{DynamicResource Text.Caption}"
                           VerticalAlignment="Center" />
                <Slider Grid.Column="1"
                        Minimum="1"
                        Maximum="200"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="{Binding VariationIntensityPercent}"
                        Margin="12,0,8,0"
                        AutomationProperties.Name="差异化滤镜强度" />
                <TextBlock Grid.Column="2"
                           Text="{Binding VariationIntensityLabel}"
                           Style="{DynamicResource Text.Mono}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>
            <!-- ═══ 音频库 ════════════════════════════════════════════ -->
            <TextBlock Text="音频库" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <Border Background="{DynamicResource Surface.PanelMuted}" BorderBrush="{DynamicResource Line.Default}" BorderThickness="1" CornerRadius="6" Padding="16,12">
                <StackPanel>
                    <CheckBox Content="{Binding AudioLibrarySwitchHint}"
                              IsChecked="{Binding EnableAudioLibrary}"
                              AutomationProperties.Name="启用音频库随机选取" />

                    <CheckBox Content="自定义固定音量"
                              IsChecked="{Binding EnableAudioFixedVolume}"
                              Margin="0,8,0,0"
                              AutomationProperties.Name="启用自定义固定音量" />

                    <Grid Margin="20,6,0,0" Visibility="{Binding IsAudioFixedVolumeSectionVisible, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="-100" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1"
                                Minimum="-100" Maximum="100"
                                Value="{Binding AudioFixedVolumePercent}"
                                Margin="8,0"
                                SmallChange="5" LargeChange="10"
                                AutomationProperties.Name="音频固定音量值" />
                        <TextBlock Grid.Column="2" Text="+100" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                    </Grid>

                    <CheckBox Content="随机音量区间"
                              IsChecked="{Binding EnableAudioRandomVolume}"
                              Margin="0,8,0,0"
                              AutomationProperties.Name="启用随机音量区间" />

                    <Grid Margin="20,6,0,0" Visibility="{Binding IsAudioRandomVolumeSectionVisible, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="最小值" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Width="48" />
                            <Slider Grid.Column="1"
                                    Minimum="-100" Maximum="100"
                                    Value="{Binding AudioVolumeMinPercent}"
                                    Margin="8,0"
                                    SmallChange="5" LargeChange="10"
                                    AutomationProperties.Name="音频随机音量最小值" />
                            <TextBlock Grid.Column="2" Text="{Binding AudioVolumeMinPercent, StringFormat={}{0:+#;-#;0}%}" Style="{DynamicResource Text.Mono}" Width="44" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="最大值" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Width="48" />
                            <Slider Grid.Column="1"
                                    Minimum="-100" Maximum="100"
                                    Value="{Binding AudioVolumeMaxPercent}"
                                    Margin="8,0"
                                    SmallChange="5" LargeChange="10"
                                    AutomationProperties.Name="音频随机音量最大值" />
                            <TextBlock Grid.Column="2" Text="{Binding AudioVolumeMaxPercent, StringFormat={}{0:+#;-#;0}%}" Style="{DynamicResource Text.Mono}" Width="44" />
                        </Grid>
                    </Grid>

                    <TextBlock Text="{Binding AudioVolumeSummary}"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding EnableAudioLibrary, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="启用后每个渲染任务从音频库随机抽取一条背景音乐，时长不够自动循环、超出自动裁剪。"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,2,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding EnableAudioLibrary, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="背景音乐（单文件）" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <Border Background="{DynamicResource Surface.PanelMuted}" BorderBrush="{DynamicResource Line.Default}" BorderThickness="1" CornerRadius="6" Padding="16,12">
            <StackPanel>
            <CheckBox Content="混入背景音乐"
                      IsChecked="{Binding EnableBgm}"
                      AutomationProperties.Name="启用背景音乐混音" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="BGM 文件" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding BgmPath, UpdateSourceTrigger=PropertyChanged}"
                         Margin="10,0,8,0"
                         Padding="8,6"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="背景音乐文件路径" />
                <Button Grid.Column="2"
                        Style="{DynamicResource Button.Secondary}"
                        Content="选择…"
                        Command="{Binding PickBgmFileCommand}"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="选择背景音乐文件" />
                <Button Grid.Column="3"
                        Style="{DynamicResource Button.Secondary}"
                        Content="清除"
                        Command="{Binding ClearBgmCommand}"
                        AutomationProperties.Name="清除背景音乐" />
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="原声音量 %" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Text="{Binding OriginalVolumePercent, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="原声音量百分比" />
                <TextBlock Grid.Column="3" Text="BGM 音量 %" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                <TextBox Grid.Column="4"
                         Text="{Binding BgmVolumePercent, UpdateSourceTrigger=PropertyChanged}"
                         Margin="10,0,0,0"
                         Padding="8,6"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="背景音乐音量百分比" />
            </Grid>
            <TextBlock Text="未选择 BGM 时保留原声；选择后 BGM 默认 18% 并循环至成片结束，尾部淡出 1 秒。"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Text="拼接主素材增强"
                       Style="{DynamicResource Text.SectionHeader}"
                       Margin="0,20,0,8" />
            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="14,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="仅对混剪主轨拼接素材生效；蒙版拼接层不受影响。音量先统一响度再调大。"
                                   Style="{DynamicResource Text.Caption}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                Background="{DynamicResource Surface.Sunk}"
                                BorderBrush="{DynamicResource Line.Default}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Small}"
                                Padding="8,4"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasMainMaterialBoostSummary, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="拼接主素材增强设置摘要">
                            <TextBlock Text="{Binding MainMaterialBoostSummary}"
                                       Style="{DynamicResource Text.Caption}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>

                    <!-- 音量 -->
                    <Border Background="{DynamicResource Surface.Sunk}"
                            BorderBrush="{DynamicResource Line.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Small}"
                            Padding="12,10"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <CheckBox Content="音量调大"
                                      IsChecked="{Binding EnableMainClipVolumeBoost}"
                                      AutomationProperties.Name="启用拼接主素材音量调大" />
                            <StackPanel Margin="0,10,0,0"
                                        IsEnabled="{Binding IsMainVolumeSectionEnabled}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Style="{DynamicResource Segmented.Container}"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                                         GroupName="mainVolumeMode"
                                                         Content="固定"
                                                         IsChecked="{Binding MainVolumeMode, Converter={StaticResource EnumToBool}, ConverterParameter=Fixed}"
                                                         AutomationProperties.Name="主素材音量固定模式" />
                                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                                         GroupName="mainVolumeMode"
                                                         Content="随机"
                                                         IsChecked="{Binding MainVolumeMode, Converter={StaticResource EnumToBool}, ConverterParameter=Random}"
                                                         AutomationProperties.Name="主素材音量随机模式" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="100–110%"
                                               Style="{DynamicResource Text.Caption}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,10,0,0"
                                      Visibility="{Binding IsMainVolumeFixedMode, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="固定值"
                                               Style="{DynamicResource Text.Caption}"
                                               VerticalAlignment="Center" />
                                    <Slider Grid.Column="1"
                                            Minimum="100"
                                            Maximum="110"
                                            TickFrequency="0.5"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding MainVolumeFixedPercent}"
                                            Margin="12,0,8,0"
                                            AutomationProperties.Name="主素材音量固定百分比" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding MainVolumeFixedLabel}"
                                               Style="{DynamicResource Text.Mono}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <StackPanel Margin="0,10,0,0"
                                            Visibility="{Binding IsMainVolumeRandomMode, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="下限"
                                                   Style="{DynamicResource Text.Caption}"
                                                   VerticalAlignment="Center"
                                                   MinWidth="32" />
                                        <Slider Grid.Column="1"
                                                Minimum="100"
                                                Maximum="110"
                                                TickFrequency="0.5"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding MainVolumeMinPercent}"
                                                Margin="12,0,8,0"
                                                AutomationProperties.Name="主素材音量随机下限" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding MainVolumeMinLabel}"
                                                   Style="{DynamicResource Text.Mono}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="上限"
                                                   Style="{DynamicResource Text.Caption}"
                                                   VerticalAlignment="Center"
                                                   MinWidth="32" />
                                        <Slider Grid.Column="1"
                                                Minimum="100"
                                                Maximum="110"
                                                TickFrequency="0.5"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding MainVolumeMaxPercent}"
                                                Margin="12,0,8,0"
                                                AutomationProperties.Name="主素材音量随机上限" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding MainVolumeMaxLabel}"
                                                   Style="{DynamicResource Text.Mono}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="{Binding MainVolumeRangeHint}"
                                           Style="{DynamicResource Text.Caption}"
                                           Foreground="{DynamicResource Status.Running.Text}"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasMainVolumeRangeHint, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 缩放 -->
                    <Border Background="{DynamicResource Surface.Sunk}"
                            BorderBrush="{DynamicResource Line.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Small}"
                            Padding="12,10"
                            Margin="0,10,0,0">
                        <StackPanel>
                            <CheckBox Content="缩放"
                                      IsChecked="{Binding EnableMainClipScale}"
                                      AutomationProperties.Name="启用拼接主素材缩放" />
                            <StackPanel Margin="0,10,0,0"
                                        IsEnabled="{Binding IsMainScaleSectionEnabled}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Style="{DynamicResource Segmented.Container}"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                                         GroupName="mainScaleMode"
                                                         Content="固定"
                                                         IsChecked="{Binding MainScaleMode, Converter={StaticResource EnumToBool}, ConverterParameter=Fixed}"
                                                         AutomationProperties.Name="主素材缩放固定模式" />
                                            <RadioButton Style="{DynamicResource Segmented.Item}"
                                                         GroupName="mainScaleMode"
                                                         Content="随机"
                                                         IsChecked="{Binding MainScaleMode, Converter={StaticResource EnumToBool}, ConverterParameter=Random}"
                                                         AutomationProperties.Name="主素材缩放随机模式" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="100–110%"
                                               Style="{DynamicResource Text.Caption}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <Grid Margin="0,10,0,0"
                                      Visibility="{Binding IsMainScaleFixedMode, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="固定值"
                                               Style="{DynamicResource Text.Caption}"
                                               VerticalAlignment="Center" />
                                    <Slider Grid.Column="1"
                                            Minimum="100"
                                            Maximum="110"
                                            TickFrequency="0.5"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding MainScaleFixedPercent}"
                                            Margin="12,0,8,0"
                                            AutomationProperties.Name="主素材缩放固定百分比" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding MainScaleFixedLabel}"
                                               Style="{DynamicResource Text.Mono}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <StackPanel Margin="0,10,0,0"
                                            Visibility="{Binding IsMainScaleRandomMode, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="下限"
                                                   Style="{DynamicResource Text.Caption}"
                                                   VerticalAlignment="Center"
                                                   MinWidth="32" />
                                        <Slider Grid.Column="1"
                                                Minimum="100"
                                                Maximum="110"
                                                TickFrequency="0.5"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding MainScaleMinPercent}"
                                                Margin="12,0,8,0"
                                                AutomationProperties.Name="主素材缩放随机下限" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding MainScaleMinLabel}"
                                                   Style="{DynamicResource Text.Mono}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="56" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="上限"
                                                   Style="{DynamicResource Text.Caption}"
                                                   VerticalAlignment="Center"
                                                   MinWidth="32" />
                                        <Slider Grid.Column="1"
                                                Minimum="100"
                                                Maximum="110"
                                                TickFrequency="0.5"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding MainScaleMaxPercent}"
                                                Margin="12,0,8,0"
                                                AutomationProperties.Name="主素材缩放随机上限" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding MainScaleMaxLabel}"
                                                   Style="{DynamicResource Text.Mono}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock Text="{Binding MainScaleRangeHint}"
                                           Style="{DynamicResource Text.Caption}"
                                           Foreground="{DynamicResource Status.Running.Text}"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasMainScaleRangeHint, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="音量与缩放范围均为 100%–110%。随机模式按任务种子对每个主轨分镜独立取值，可复现。"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid x:Name="EnqueueFeedback" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding ValidationMessage}"
                               Style="{DynamicResource Text.Caption}"
                               Foreground="{DynamicResource Status.Failed}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasValidationMessage, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{DynamicResource Text.Caption}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{DynamicResource Button.Primary}"
                        Content="加入队列"
                        HorizontalAlignment="Left"
                        Command="{Binding EnqueueCommand}"
                        AutomationProperties.Name="将编排结果加入渲染队列" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
