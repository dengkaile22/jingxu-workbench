<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- 圆角：标准 10，紧凑 6（更柔和的现代感）。 -->
    <CornerRadius x:Key="Radius.Standard">10</CornerRadius>
    <CornerRadius x:Key="Radius.Small">6</CornerRadius>

    <!-- 1px 发丝边框。 -->
    <Thickness x:Key="Stroke.Hairline">1</Thickness>

    <!-- 4 / 8 间距体系派生的内边距。 -->
    <Thickness x:Key="Pad.Panel">16</Thickness>
    <Thickness x:Key="Pad.Section">12</Thickness>
    <Thickness x:Key="Pad.Compact">8</Thickness>
    <Thickness x:Key="Pad.Field">8,6</Thickness>

    <!-- 六区尺寸（逻辑像素）。 -->
    <sys:Double x:Key="Size.TitleBar">44</sys:Double>
    <sys:Double x:Key="Size.Rail">56</sys:Double>
    <sys:Double x:Key="Size.MaterialRail">260</sys:Double>
    <sys:Double x:Key="Size.Inspector">300</sys:Double>
    <sys:Double x:Key="Size.Queue">144</sys:Double>
    <sys:Double x:Key="Size.QueueCollapsed">36</sys:Double>

    <!-- 键盘焦点环粗细。 -->
    <sys:Double x:Key="Focus.Ring.Thickness">2</sys:Double>

</ResourceDictionary>
