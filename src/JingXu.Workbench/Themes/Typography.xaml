<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 字体族。
         正文/显示：优先思源黑体 / Noto Sans SC，回退到 Microsoft YaHei UI（未嵌入 CJK 字体，
         体积过大，使用系统回退栈，见任务回报说明）。
         等宽：已在包内嵌入 IBM Plex Mono（OFL-1.1，Regular），中文字形由系统字体链接补齐，
         整体不可用时回退到 Consolas。 -->
    <FontFamily x:Key="Font.Display">Source Han Sans SC, Noto Sans SC, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Body">Source Han Sans SC, Noto Sans SC, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Mono">/Assets/Fonts/#IBM Plex Mono, Consolas</FontFamily>

    <!-- 铭牌「镜序」：粗字重（字距在布局中通过分字排布实现）。 -->
    <Style x:Key="Text.Wordmark" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Ink.Primary}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Text.ProductLine" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Ink.Muted}" />
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Ink.Primary}" />
    </Style>

    <Style x:Key="Text.SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Ink.Muted}" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Ink.Primary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Body}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource Ink.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Ink.Primary}" />
    </Style>

    <!-- 取景井（深底）上的文字 -->
    <Style x:Key="Text.Gate.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource On.Gate}" />
    </Style>

    <Style x:Key="Text.Gate.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource On.Gate.Muted}" />
    </Style>

</ResourceDictionary>
