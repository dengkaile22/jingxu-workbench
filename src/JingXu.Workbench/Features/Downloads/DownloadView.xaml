<UserControl x:Class="JingXu.Workbench.Features.Downloads.DownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:downloads="clr-namespace:JingXu.Workbench.Features.Downloads"
             xmlns:appDownloads="clr-namespace:JingXu.Workbench.Application.Downloads;assembly=JingXu.Workbench.Application"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance downloads:DownloadViewModel}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,12" Padding="12" Background="{DynamicResource Surface.PanelMuted}" CornerRadius="{DynamicResource Radius.Small}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="保存到:" VerticalAlignment="Center" Margin="0,0,10,0" Style="{DynamicResource Text.Body}" />
                <TextBlock Grid.Column="1" Text="{Binding SaveDirectory}" VerticalAlignment="Center" Style="{DynamicResource Text.Body}" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Content="浏览" Command="{Binding BrowseSaveDirectoryCommand}" Padding="10,4" Style="{DynamicResource Button.Secondary}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="粘贴视频链接（每行一个）:" Style="{DynamicResource Text.SectionHeader}" Margin="0,0,0,6" />
            <TextBox Grid.Row="1"
                     Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Padding="10"
                     FontFamily="{DynamicResource Font.Mono}"
                     FontSize="13"
                     Background="{DynamicResource Surface.Panel}"
                     BorderBrush="{DynamicResource Line.Default}"
                     BorderThickness="1"
                     AutomationProperties.Name="粘贴视频链接" />
            <Button Grid.Row="2" Content="解析链接" Command="{Binding ParseUrlsCommand}" HorizontalAlignment="Right" Margin="0,8,0,0" Padding="16,6" Style="{DynamicResource Button.Secondary}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="#" Style="{DynamicResource Text.Caption}" />
                <TextBlock Grid.Column="1" Text="文件名" Style="{DynamicResource Text.Caption}" />
                <TextBlock Grid.Column="2" Text="进度" Style="{DynamicResource Text.Caption}" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="速度" Style="{DynamicResource Text.Caption}" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="状态" Style="{DynamicResource Text.Caption}" HorizontalAlignment="Right" Margin="0,0,8,0" />
            </Grid>

            <ScrollViewer Grid.Row="1" MaxHeight="300" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type appDownloads:DownloadItem}">
                            <Border Margin="0,0,0,4" Padding="8,6" Background="{DynamicResource Surface.PanelMuted}" CornerRadius="{DynamicResource Radius.Small}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Index}" Style="{DynamicResource Text.Mono}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" FontFamily="{DynamicResource Font.Body}" FontSize="14" Foreground="{DynamicResource Ink.Primary}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" />
                                    <Grid Grid.Column="2" Margin="8,0" VerticalAlignment="Center">
                                        <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Visibility="{Binding ProgressPercent, Converter={StaticResource DownloadProgressToVis}}" />
                                        <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:0}%}" Style="{DynamicResource Text.Mono}" FontSize="11" HorizontalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Grid.Column="3" Text="{Binding BytesPerSecond, Converter={StaticResource BytesPerSecond}}" Style="{DynamicResource Text.Mono}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0">
                                        <TextBlock HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="等待" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Downloading">
                                                            <Setter Property="Text" Value="下载中" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Completed">
                                                            <Setter Property="Text" Value="✓ 已完成" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                                            <Setter Property="Text" Value="✗ 失败" />
                                                            <Setter Property="ToolTip" Value="{Binding ErrorMessage}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Cancelled">
                                                            <Setter Property="Text" Value="已取消" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ErrorMessage}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Status.Failed}"
                                                   TextWrapping="Wrap"
                                                   HorizontalAlignment="Right"
                                                   TextAlignment="Right"
                                                   MaxWidth="210"
                                                   ToolTip="{Binding ErrorMessage}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Failed">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="12" Background="{DynamicResource Surface.PanelMuted}" CornerRadius="{DynamicResource Radius.Small}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="开始下载" Command="{Binding DownloadCommand}" Padding="16,6" Margin="0,0,8,0" Style="{DynamicResource Button.Primary}" />
                <Button Grid.Column="1" Content="全部暂停" Command="{Binding CancelAllCommand}" Padding="16,6" Margin="0,0,8,0" Style="{DynamicResource Button.Secondary}" />
                <Button Grid.Column="2" Content="清空列表" Command="{Binding ClearListCommand}" Padding="16,6" Style="{DynamicResource Button.Secondary}" />
                <TextBlock Grid.Column="3" Text="{Binding StatusText}" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
