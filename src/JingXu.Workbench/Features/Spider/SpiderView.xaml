<UserControl x:Class="JingXu.Workbench.Features.Spider.SpiderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:spider="clr-namespace:JingXu.Workbench.Features.Spider"
             xmlns:appSpider="clr-namespace:JingXu.Workbench.Application.Spider;assembly=JingXu.Workbench.Application"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance spider:SpiderViewModel}"
             Background="Transparent">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ════════════════════ 左栏：配置与对标账号 ════════════════════ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <!-- 模块标题栏 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="对标账号" Style="{DynamicResource Text.Heading}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource Surface.Sunk}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AccountCount, StringFormat={}{0} 个}" FontSize="11" FontFamily="{DynamicResource Font.Mono}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{DynamicResource Button.Secondary}" Content="加载配置" Command="{Binding LoadConfigCommand}" Padding="8,4" Margin="0,0,4,0" FontSize="11" />
                        <Button Style="{DynamicResource Button.Secondary}" Content="保存" Command="{Binding SaveConfigCommand}" Padding="8,4" FontSize="11" />
                    </StackPanel>
                </Grid>

                <!-- 对标账号列表 -->
                <Border Background="{DynamicResource Surface.Panel}"
                        BorderBrush="{DynamicResource Line.Default}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Small}"
                        Padding="8"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Accounts}"
                                 SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 MaxHeight="220"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="6,4" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Border"
                                                        Background="{DynamicResource Surface.PanelMuted}"
                                                        BorderBrush="{DynamicResource Line.Default}"
                                                        BorderThickness="1"
                                                        CornerRadius="{DynamicResource Radius.Small}"
                                                        Padding="8,6">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Brand.Bloom}" />
                                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource Surface.Sunk}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type appSpider:SpiderAccount}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <Border Grid.Column="1" Background="{DynamicResource Brand.Muted}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Platform}" FontSize="10" Style="{DynamicResource Text.Mono}" Foreground="{DynamicResource Brand.Bloom}" />
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding UrlOrId}" Style="{DynamicResource Text.Caption}" FontSize="10" TextTrimming="CharacterEllipsis" Opacity="0.75" />
                                        </StackPanel>
                                        <Button Grid.Column="3"
                                                Content="×"
                                                Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="4,1"
                                                FontSize="13"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{DynamicResource Ink.Tertiary}"
                                                VerticalAlignment="Center"
                                                ToolTip="移除此对标账号" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- 添加新账号卡片 -->
                <Border Background="{DynamicResource Surface.PanelMuted}"
                        BorderBrush="{DynamicResource Line.Default}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Small}"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="添加对标账号" Style="{DynamicResource Text.Title}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" SelectedValuePath="Tag" SelectedValue="{Binding NewAccountPlatform, Mode=TwoWay}" Margin="0,0,6,0" Height="28">
                                <ComboBoxItem Content="抖音" Tag="douyin" IsSelected="True" />
                                <ComboBoxItem Content="快手" Tag="kuaishou" />
                            </ComboBox>
                            <TextBox Grid.Column="1" Text="{Binding NewAccountName, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4" ToolTip="账号备注/达人昵称" />
                        </Grid>
                        <TextBox Text="{Binding NewAccountUrl, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="6,4" Margin="0,0,0,8" ToolTip="粘贴对标主页链接、分享短链或 Sec-UID / ID" />
                        <Button Content="+ 添加账号" Command="{Binding AddAccountCommand}" Style="{DynamicResource Button.Primary}" HorizontalAlignment="Right" Padding="14,4" />

                        <TextBlock Text="批量导入（每行一个主页链接/短链/ID，自动识别平台）:" Style="{DynamicResource Text.Caption}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding BulkAccountText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="60"
                                 Padding="6,4"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="支持「备注 链接」格式；抖音与快手链接会自动识别平台" />
                        <Button Content="批量导入" Command="{Binding ImportAccountsCommand}" Style="{DynamicResource Button.Secondary}" HorizontalAlignment="Right" Padding="14,4" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- 爬取与共性保留门槛 -->
                <Border Background="{DynamicResource Surface.PanelMuted}"
                        BorderBrush="{DynamicResource Line.Default}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Small}"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="爬取与共性保留规则" Style="{DynamicResource Text.Title}" Margin="0,0,0,8" />

                        <!-- 时间范围 -->
                        <TextBlock Text="时间范围 (遇到超期视频自动早停):" Style="{DynamicResource Text.Caption}" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" SelectedValuePath="Tag" SelectedValue="{Binding TimeMode, Mode=TwoWay}" Height="28" Margin="0,0,6,0">
                                <ComboBoxItem Content="按天数" Tag="days" />
                                <ComboBoxItem Content="按日期范围" Tag="range" />
                                <ComboBoxItem Content="全部历史" Tag="all" />
                            </ComboBox>
                            <TextBox Grid.Column="1" Text="{Binding TimeDays, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsDaysMode}" Height="28" Padding="4,2" HorizontalContentAlignment="Center" FontFamily="{DynamicResource Font.Mono}" ToolTip="近 N 天" />
                            <TextBlock Grid.Column="2" Text="天内" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </Grid>
                        <Grid Margin="0,0,0,8" IsEnabled="{Binding IsRangeMode}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0" SelectedDate="{Binding StartDate, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1" Text="至" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" Margin="6,0" />
                            <DatePicker Grid.Column="2" SelectedDate="{Binding EndDate, Mode=TwoWay}" />
                        </Grid>

                        <!-- 保留阈值 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="共同带货账号数 >= N (共性爆品核心):" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding MinAccountCount, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="26" Padding="4,2" HorizontalContentAlignment="Center" FontFamily="{DynamicResource Font.Mono}" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="累计带货频次 >= M:" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding MinTotalOccurrences, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="26" Padding="4,2" HorizontalContentAlignment="Center" FontFamily="{DynamicResource Font.Mono}" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="过滤准则:" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding FilterBy, Mode=TwoWay}" Width="120" Height="26">
                                <ComboBoxItem Content="仅跨账号数" Tag="accounts" />
                                <ComboBoxItem Content="仅总频次" Tag="total" />
                                <ComboBoxItem Content="两者均满足" Tag="both" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="单账号最大滚动翻页:" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding MaxScrolls, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="26" Padding="4,2" HorizontalContentAlignment="Center" FontFamily="{DynamicResource Font.Mono}" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="同款模糊合并阈值 (0.5-1.0):" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" ToolTip="相似度越高要求越严格；低于阈值不会被合并" />
                            <TextBox Grid.Column="1" Text="{Binding FuzzyThreshold, UpdateSourceTrigger=LostFocus}" Width="50" Height="26" Padding="4,2" HorizontalContentAlignment="Center" FontFamily="{DynamicResource Font.Mono}" />
                        </Grid>

                        <CheckBox Content="开启智能去噪与同款商品模糊合并" IsChecked="{Binding EnableFuzzy, Mode=TwoWay}" Margin="0,0,0,6" ToolTip="自动去除【官方正品】、规格字样，将同款不同包装合并为一款商品统计" />
                        <CheckBox Content="无头后台静默运行 (不弹出浏览器窗口)" IsChecked="{Binding Headless, Mode=TwoWay}" Margin="0,0,0,6" />
                    </StackPanel>
                </Border>

                <!-- Python 运行环境状态 -->
                <Border Background="{DynamicResource Surface.Panel}"
                        BorderBrush="{DynamicResource Line.Default}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Small}"
                        Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="爬虫运行环境" FontSize="11" FontWeight="SemiBold" Style="{DynamicResource Text.Caption}" />
                            <TextBlock Text="{Binding PythonStatusText}" FontSize="10" TextWrapping="Wrap" Style="{DynamicResource Text.Mono}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="重新检测" Command="{Binding CheckEnvironmentCommand}" Padding="6,2" FontSize="10" Style="{DynamicResource Button.Secondary}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ════════════════════ 右栏：控制台与爆品表格 ════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 顶部操作条 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Surface.Panel}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Small}"
                    Padding="12,10"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="🚀 开始爬取与分析"
                            Command="{Binding StartCrawlCommand}"
                            Style="{DynamicResource Button.Primary}"
                            Padding="16,6"
                            Margin="0,0,8,0"
                            FontWeight="Bold" />

                    <Button Grid.Column="1"
                            Content="■ 停止"
                            Command="{Binding CancelCrawlCommand}"
                            Style="{DynamicResource Button.Secondary}"
                            Padding="12,6"
                            Margin="0,0,8,0" />

                    <Button Grid.Column="2"
                            Content="🔑 扫码登录抖音"
                            Command="{Binding LoginDouyinCommand}"
                            Style="{DynamicResource Button.Secondary}"
                            Padding="10,6"
                            Margin="0,0,6,0"
                            ToolTip="打开浏览器窗口扫码登录抖音并持久化 Cookie" />

                    <Button Grid.Column="3"
                            Content="🔑 扫码登录快手"
                            Command="{Binding LoginKuaishouCommand}"
                            Style="{DynamicResource Button.Secondary}"
                            Padding="10,6"
                            Margin="0,0,8,0"
                            ToolTip="打开浏览器窗口扫码登录快手并持久化 Cookie" />

                    <Button Grid.Column="4"
                            Content="📂 数据目录"
                            Command="{Binding OpenDataDirectoryCommand}"
                            Style="{DynamicResource Button.Secondary}"
                            Padding="10,6"
                            Margin="0,0,6,0"
                            ToolTip="打开配置、报表与浏览器登录态所在目录" />

                    <Button Grid.Column="5"
                            Content="📊 最近报表"
                            Command="{Binding OpenReportCommand}"
                            IsEnabled="{Binding HasReport}"
                            Style="{DynamicResource Button.Secondary}"
                            Padding="10,6"
                            Margin="0,0,8,0"
                            ToolTip="打开最近一次爬取导出的 Excel 报表" />

                    <TextBlock Grid.Column="6"
                               Text="{Binding LastResultText}"
                               Style="{DynamicResource Text.Caption}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding LastResultText}" />

                    <Button Grid.Column="7"
                            Content="🖥️ 打开独立界面"
                            Command="{Binding LaunchStandaloneGuiCommand}"
                            Style="{DynamicResource Button.Secondary}"
                            Padding="12,6"
                            ToolTip="开发仓可唤起原 PySide6 独立界面；安装包默认不含该界面" />
                </Grid>
            </Border>

            <!-- 结果与日志 Tab 控制器 -->
            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                <!-- Tab 1: 筛选出的共性爆品表格 -->
                <TabItem Header="{Binding RetainedCount, StringFormat=🎯 筛选出的共同带货爆品 ({0}款)}" FontSize="13">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.5*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 爆品汇总表格 -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource Surface.Panel}"
                                BorderBrush="{DynamicResource Line.Default}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Small}">
                            <DataGrid ItemsSource="{Binding RetainedProducts}"
                                      SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      RowHeight="36"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="商品名称" Binding="{Binding ProductName}" Width="2*" />
                                    <DataGridTextColumn Header="清洗归一名称" Binding="{Binding CleanedName}" Width="1.8*" />
                                    <DataGridTextColumn Header="平台" Binding="{Binding Platform}" Width="70" />
                                    <DataGridTextColumn Header="对标账号数" Binding="{Binding AccountCount}" Width="90" />
                                    <DataGridTextColumn Header="带货视频数" Binding="{Binding VideoCount}" Width="90" />
                                    <DataGridTextColumn Header="带货达人明细" Binding="{Binding AccountsDetail}" Width="1.5*" />
                                    <DataGridTextColumn Header="参考售价" Binding="{Binding PriceRange}" Width="100" />
                                    <DataGridTextColumn Header="示例视频链接" Binding="{Binding SampleVideoUrl}" Width="1.5*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- 选中爆品的关联带货明细 -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource Surface.Panel}"
                                BorderBrush="{DynamicResource Line.Default}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Small}"
                                Margin="0,10,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="10,8,10,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="选中爆品的关联带货明细"
                                               Style="{DynamicResource Text.Caption}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="▶ 打开视频"
                                            Command="{Binding OpenSelectedVideoCommand}"
                                            Style="{DynamicResource Button.Secondary}"
                                            Padding="10,3"
                                            FontSize="11"
                                            Margin="0,0,6,0" />
                                    <Button Grid.Column="2"
                                            Content="🛒 打开商品链接"
                                            Command="{Binding OpenSelectedProductLinkCommand}"
                                            Style="{DynamicResource Button.Secondary}"
                                            Padding="10,3"
                                            FontSize="11"
                                            Margin="0,0,6,0" />
                                    <Button Grid.Column="3"
                                            Content="🎬 打开示例视频"
                                            Command="{Binding OpenSelectedSampleVideoCommand}"
                                            Style="{DynamicResource Button.Secondary}"
                                            Padding="10,3"
                                            FontSize="11" />
                                </Grid>

                                <DataGrid Grid.Row="1"
                                          ItemsSource="{Binding SelectedProduct.Items}"
                                          SelectedItem="{Binding SelectedProductItem, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          RowHeight="28"
                                          SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="平台" Binding="{Binding Platform}" Width="60" />
                                        <DataGridTextColumn Header="带货账号" Binding="{Binding AccountName}" Width="120" />
                                        <DataGridTextColumn Header="视频标题" Binding="{Binding VideoTitle}" Width="2*" />
                                        <DataGridTextColumn Header="发布时间" Binding="{Binding PublishTime}" Width="140" />
                                        <DataGridTextColumn Header="售价" Binding="{Binding Price}" Width="80" />
                                        <DataGridTextColumn Header="商品原始名称" Binding="{Binding ProductName}" Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- 表格下方联动操作栏 -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource Surface.PanelMuted}"
                                BorderBrush="{DynamicResource Line.Default}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Small}"
                                Padding="12,10"
                                Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                <Button Grid.Column="1"
                                        Content="📥 发送选中爆品视频到下载模块"
                                        Command="{Binding SendSelectedVideosToDownloadsCommand}"
                                        Style="{DynamicResource Button.Secondary}"
                                        Padding="14,6"
                                        Margin="0,0,8,0"
                                        ToolTip="将当前选中的爆品视频链接自动填入下载模块并开始解析" />

                                <Button Grid.Column="2"
                                        Content="⚡ 发送全部爆品视频到下载模块"
                                        Command="{Binding SendAllVideosToDownloadsCommand}"
                                        Style="{DynamicResource Button.Primary}"
                                        Padding="16,6"
                                        ToolTip="一键将所有跨账号爆品关联视频全部推入下载队列，直接作为剪辑素材使用！" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 2: 实时控制台日志 -->
                <TabItem Header="📋 运行日志" FontSize="13">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource Surface.Sunk}"
                                BorderBrush="{DynamicResource Line.Strong}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Small}"
                                Padding="10">
                            <TextBox Text="{Binding LogText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="Transparent"
                                     Foreground="{DynamicResource Ink.Primary}"
                                     BorderThickness="0"
                                     FontFamily="{DynamicResource Font.Mono}"
                                     FontSize="12" />
                        </Border>

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <TextBlock Text="{Binding StatusMessage}" Style="{DynamicResource Text.Caption}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Button Content="清空日志" Command="{Binding ClearLogCommand}" Style="{DynamicResource Button.Secondary}" Padding="12,4" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
