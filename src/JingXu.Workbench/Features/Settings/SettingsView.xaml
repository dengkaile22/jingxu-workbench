<UserControl x:Class="JingXu.Workbench.Features.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:JingXu.Workbench.Features.Settings"
             xmlns:runtime="clr-namespace:JingXu.Workbench.Infrastructure.Runtime;assembly=JingXu.Workbench.Infrastructure"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance settings:SettingsViewModel}"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{DynamicResource Text.Title}" />

            <!-- 离线声明 -->
            <Border Margin="0,14,0,0"
                    Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="14,12">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Brand.Primary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding OfflineStatement}" Style="{DynamicResource Text.Body}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- 应用信息 -->
            <TextBlock Text="应用" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="版本" Style="{DynamicResource Text.Caption}" Margin="0,4" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}" Style="{DynamicResource Text.Mono}" Margin="0,4" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="数据目录" Style="{DynamicResource Text.Caption}" Margin="0,4" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DataDirectory}" Style="{DynamicResource Text.Mono}" TextWrapping="Wrap" Margin="0,4" />
            </Grid>

            <!-- 渲染并发 -->
            <TextBlock Text="渲染并发" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="14,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="同时渲染任务数"
                                   Style="{DynamicResource Text.Caption}"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ConcurrencyOptions}"
                                  SelectedItem="{Binding MaxRenderConcurrency}"
                                  Margin="12,0,8,0"
                                  Padding="8,6"
                                  AutomationProperties.Name="渲染并发上限" />
                        <Button Grid.Column="2"
                                Style="{DynamicResource Button.Secondary}"
                                Content="应用"
                                Command="{Binding ApplyRenderConcurrencyCommand}"
                                AutomationProperties.Name="应用渲染并发" />
                    </Grid>
                    <TextBlock Text="{Binding ConcurrencyHint}"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ConcurrencyStatusMessage}"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,6,0,0"
                               Visibility="{Binding HasConcurrencyStatus, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- 缓存清理 -->
            <TextBlock Text="缓存与临时文件" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="14,12">
                <StackPanel>
                    <TextBlock Text="清理已失效的渲染暂存、下载半成品、预览及识别临时文件和蒙版缩略图缓存。正在使用的文件、素材库、模板、备份和已导出的成片会保留；失败任务日志单独保存。"
                               Style="{DynamicResource Text.Caption}"
                               TextWrapping="Wrap" />
                    <Button Style="{DynamicResource Button.Secondary}"
                            Content="清理工作台缓存"
                            Command="{Binding ClearWorkbenchCacheCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,10,0,0"
                            AutomationProperties.Name="清理工作台缓存" />
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0"
                                 Visibility="{Binding IsCleaningCache, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding CacheCleanupStatusMessage}"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasCacheCleanupStatus, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- GPU 各处理阶段的实测能力（只读诊断） -->
            <TextBlock Text="GPU 加速" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <Border Background="{DynamicResource Surface.PanelMuted}"
                    BorderBrush="{DynamicResource Line.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Standard}"
                    Padding="14,12">
                <StackPanel>
                    <TextBlock Text="{Binding GpuEncoderStatus}"
                               Style="{DynamicResource Text.Body}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="GPU编码器状态" />
                    <TextBlock Text="{Binding GpuProcessingStatus}"
                               Style="{DynamicResource Text.Body}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="GPU解码与缩放状态" />
                    <TextBlock Text="{Binding GpuEncoderHint}"
                               Style="{DynamicResource Text.Caption}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 运行时诊断 -->
            <TextBlock Text="运行时诊断" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <TextBlock Text="检测 FFmpeg、FFprobe、Whisper 与 Tesseract 是否可用。完全离线，不会联网校验。"
                       Style="{DynamicResource Text.Caption}"
                       Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding RuntimeStatuses}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type runtime:RuntimeComponentStatus}">
                        <Border BorderBrush="{DynamicResource Line.Default}"
                                BorderThickness="0,0,0,1"
                                Padding="0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Message}" Style="{DynamicResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Style="{DynamicResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0">
                                    <Run Text="路径提示：" />
                                    <Run Text="{Binding SuggestedAction, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 运行时解析顺序 -->
            <TextBlock Text="外部运行时解析顺序" Style="{DynamicResource Text.SectionHeader}" Margin="0,20,0,8" />
            <ItemsControl ItemsSource="{Binding RuntimeSearchOrder}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type settings:RuntimeSearchEntry}">
                        <Border BorderBrush="{DynamicResource Line.Default}" BorderThickness="0,0,0,1" Padding="0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="22"
                                        Height="22"
                                        CornerRadius="{DynamicResource Radius.Small}"
                                        Background="{DynamicResource Surface.Sunk}"
                                        VerticalAlignment="Top"
                                        Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Order}"
                                               Style="{DynamicResource Text.Mono}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Location}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Style="{DynamicResource Text.Caption}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 数据目录状态 + 刷新 -->
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Style="{DynamicResource Text.Caption}">
                    <Run Text="数据目录状态：" />
                    <Run Text="{Binding DataDirectoryStatusText, Mode=OneWay}" />
                </TextBlock>
                <Button Content="刷新诊断"
                        Style="{DynamicResource Button.Secondary}"
                        Command="{Binding RefreshDiagnosticsCommand}"
                        Margin="14,0,0,0"
                        AutomationProperties.Name="刷新运行诊断" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
