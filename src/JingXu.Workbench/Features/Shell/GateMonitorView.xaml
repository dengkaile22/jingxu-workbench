<UserControl x:Class="JingXu.Workbench.Features.Shell.GateMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:JingXu.Workbench.Features.Shell"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance shell:GateMonitorViewModel}"
             Background="Transparent">

    <Grid>
        <MediaElement x:Name="PreviewPlayer"
                      Source="{Binding PreviewVideoPath}"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Stretch="Uniform"
                      Visibility="{Binding HasVideoPlayback, Converter={StaticResource BoolToVis}}"
                      MediaOpened="PreviewPlayer_OnMediaOpened"
                      MediaFailed="PreviewPlayer_OnMediaFailed" />

        <Image Source="{Binding PreviewImagePath}"
               Stretch="Uniform"
               Visibility="{Binding HasStaticFrame, Converter={StaticResource BoolToVis}}" />

        <Border Background="#AA0B1411"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="正在加载预览…"
                       Style="{DynamicResource Text.Gate.Caption}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding ShowIdleChrome, Converter={StaticResource BoolToVis}}">
            <Path Data="{DynamicResource Icon.Mark.Interlock}"
                  Stroke="{DynamicResource On.Gate.Muted}"
                  StrokeThickness="1.3"
                  StrokeLineJoin="Round"
                  Width="58"
                  Height="58"
                  Stretch="Uniform"
                  HorizontalAlignment="Center"
                  Opacity="0.9" />
            <TextBlock Text="镜序 · 光学编排台"
                       Style="{DynamicResource Text.Gate.Title}"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,0" />
            <TextBlock Text="{Binding MonitorCaption}"
                       Style="{DynamicResource Text.Gate.Caption}"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />
            <TextBlock Text="{Binding MonitorHint}"
                       Style="{DynamicResource Text.Gate.Caption}"
                       HorizontalAlignment="Center"
                       Margin="0,3,0,0" />
        </StackPanel>

        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Background="#990B1411"
                Padding="14,10"
                Visibility="{Binding ShowPreviewContent, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="{Binding MonitorCaption}"
                           Style="{DynamicResource Text.Gate.Caption}"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding MonitorHint}"
                           Style="{DynamicResource Text.Gate.Caption}"
                           Margin="0,2,0,0"
                           Opacity="0.85" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
